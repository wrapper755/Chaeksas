# 복사해서 `.env`로 쓴다. **`.env`는 커밋하지 않는다** (CLAUDE.md §5 — 비밀은 코드·설정 파일에 넣지 않는다).
# 토큰은 길고 무작위로: `python -c "import secrets;print(secrets.token_urlsafe(32))"`
CHK_CENTER__ADMIN_TOKEN=
CHK_CENTER__READ_TOKEN=
# 콘솔 로그인 쿠키를 암호화하는 비밀 (16자 이상). 바꾸면 들어와 있던 사람이 다시 로그인한다.
CHK_CONSOLE__SESSION_SECRET=
# UI 자동화 앱: 관리 API(키 발급·사용 기록)를 여는 토큰. 없으면 그 경로는 503이다.
CHK_SVC_UI_AUTOMATION__ADMIN_TOKEN=
CHK_SVC_CONSOLE__SESSION_SECRET=

# 호스트 쪽 포트를 비워 두면 문서의 기본값(Center 8800, Center 콘솔 8501, UI 자동화 앱 8000, 앱 콘솔 8001)을 쓴다.
# 그 포트를 이미 쓰는 것이 있을 때만 채운다 (컨테이너 안의 포트는 바뀌지 않는다).
CHK_CENTER__HOST_PORT=
CHK_CONSOLE__HOST_PORT=
CHK_SVC_UI_AUTOMATION__HOST_PORT=
CHK_SVC_CONSOLE__HOST_PORT=
