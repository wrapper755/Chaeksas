# 복사해서 `.env`로 쓴다. **`.env`는 커밋하지 않는다** (CLAUDE.md §5 — 비밀은 코드·설정 파일에 넣지 않는다).
# 토큰·비밀은 길고 무작위로: `python -c "import secrets;print(secrets.token_urlsafe(32))"`
# 첫 관리자 계정 — Center 콘솔에 이 아이디·비밀번호로 들어온다. **계정이 하나도 없을 때만** 쓰이고, 그다음에는
# 콘솔 「관리자 계정」에서 바꾸고 더한다(여기 값을 고쳐도 비밀번호가 바뀌지 않는다).
# 아이디를 비우면 admin. 비밀번호는 12자 이상, 영문과 숫자를 모두 넣는다 — 규칙에 맞지 않으면 Center가 뜨지 않는다.
# 비밀번호를 비우면 Center가 만들어 로그(`docker compose logs center`)와 볼륨의 first-admin-password.txt에 둔다.
CHK_CENTER__FIRST_ADMIN__USERNAME=
CHK_CENTER__FIRST_ADMIN__PASSWORD=
# 자동화(스크립트)가 Center API를 부를 때 쓰는 토큰 — 쓰지 않으면 비워 둔다(비우면 그 길이 닫힌다).
CHK_CENTER__ADMIN_TOKEN=
CHK_CENTER__READ_TOKEN=
# 콘솔 로그인 쿠키를 암호화하는 비밀 (16자 이상). 바꾸면 들어와 있던 사람이 다시 로그인한다.
CHK_CONSOLE__SESSION_SECRET=
# 콘솔 위 막대에 보일 Center 주소 — PC 실행기·Studio에 적는 바깥 주소 (예: https://center.example.com). 비우면 http://localhost:8800 — 포트를 옮겼거나 바깥(터널·프록시)으로 들어오면 꼭 적는다.
CHK_CONSOLE__CENTER_PUBLIC_URL=
# UI 자동화 앱: 관리 API(키 발급·사용 기록)를 여는 토큰. 없으면 그 경로는 503이다.
CHK_SVC_UI_AUTOMATION__ADMIN_TOKEN=
CHK_SVC_CONSOLE__SESSION_SECRET=
# 앱 콘솔의 「실행 id」가 여는 Center 콘솔 주소 (예: https://console.example.com). 비우면 http://localhost:8501.
CHK_SVC_CONSOLE__CENTER_CONSOLE_URL=

# 서버 실행기 — 콘솔 「서버 실행」에 보일 이름 (비우면 server-runner).
CHK_SERVER_RUNNER__NAME=
# 들이기 비밀 (필수, ADR-0117) — Center와 실행기에 같이 들어가 실행기가 승인 없이 키를 받는다. 길고 무작위로.
# 바꾸면 이미 들어온 실행기는 그대로이고, 비밀 볼륨을 지운 뒤 다시 들어올 때부터 새 값을 쓴다.
CHK_SERVER_RUNNER__JOIN_TOKEN=
# 비워 둔다: 실행기는 위 비밀로 키를 받는다. 채우면 그 키가 이기고 키 회전을 하지 않는다 — CI·자동화용 (deploy/README.md).
CHK_SERVER_RUNNER__CENTER_API_KEY=
# 실행기의 모델 (AI 태스크). 호스트의 모델은 http://host.docker.internal:<포트>/v1. 비우면 AI 태스크가 실패한다.
CHK_SERVER_RUNNER__LLM__BASE_URL=
CHK_SERVER_RUNNER__LLM__MODEL=
CHK_SERVER_RUNNER__LLM__API_KEY=
# 메일·웹훅. 비우면 보내지 않고 실패한다. 웹훅 허용 호스트는 쉼표로 여럿.
CHK_SERVER_RUNNER__SMTP__HOST=
CHK_SERVER_RUNNER__SMTP__FROM=
CHK_SERVER_RUNNER__SMTP__USERNAME=
CHK_SERVER_RUNNER__SMTP__PASSWORD=
CHK_SERVER_RUNNER__WEBHOOK__ALLOWED_HOSTS=

# 호스트 쪽 포트를 비워 두면 문서의 기본값(Center 8800, Center 콘솔 8501, UI 자동화 앱 8000, 앱 콘솔 8001)을 쓴다.
# 그 포트를 이미 쓰는 것이 있을 때만 채운다 (컨테이너 안의 포트는 바뀌지 않는다).
CHK_CENTER__HOST_PORT=
CHK_CONSOLE__HOST_PORT=
CHK_SVC_UI_AUTOMATION__HOST_PORT=
CHK_SVC_CONSOLE__HOST_PORT=
