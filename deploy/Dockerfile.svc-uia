# UI 자동화 앱 컨테이너 — 화면 레지스트리의 서버 부분 (C9·C11, ADR-0017 §1).
# `Dockerfile.center`와 같은 뼈대다. 다른 것은 설치하는 멤버와 진입점뿐이다.
FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    # **이미지의 Python을 쓴다** (Dockerfile.center와 같은 이유 — `/root`는 0700이다).
    UV_PYTHON_PREFERENCE=only-system \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY packages/contracts/pyproject.toml packages/contracts/
COPY packages/extension_api/pyproject.toml packages/extension_api/
COPY packages/core/pyproject.toml packages/core/
COPY packages/llm/pyproject.toml packages/llm/
COPY packages/qt/pyproject.toml packages/qt/
COPY packages/service_kit/pyproject.toml packages/service_kit/
COPY apps/center/pyproject.toml apps/center/
COPY apps/studio/pyproject.toml apps/studio/
COPY apps/bot_ui/pyproject.toml apps/bot_ui/
COPY apps/server_runner/pyproject.toml apps/server_runner/
COPY apps/admin/pyproject.toml apps/admin/
COPY extensions/ui_automation/pyproject.toml extensions/ui_automation/

# 서버에 필요한 것만 (Qt·PySide6는 들어가지 않는다 — 확장의 클라이언트 기여는 쓰지 않는다).
RUN uv sync --frozen --no-install-workspace --package chaeksas-ext-ui-automation

COPY packages/ packages/
COPY extensions/ui_automation/ extensions/ui_automation/
RUN uv sync --frozen --package chaeksas-ext-ui-automation

ENV CHK_SVC_UI_AUTOMATION__DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8000

RUN useradd --create-home --uid 10001 chaeksas && mkdir -p /data && chown -R chaeksas /data /app
USER chaeksas

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/healthz')"

CMD ["uv", "run", "--frozen", "--package", "chaeksas-ext-ui-automation", "chk-svc-uia"]
