{
  "$id": "urn:chaeksas:contracts:c5-who-am-i",
  "additionalProperties": true,
  "description": "`GET /auth/me` — 지금 부르는 쪽. 세션이면 계정, 토큰이면 `account`가 없다.",
  "properties": {
    "account": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account"
    },
    "actor": {
      "title": "Actor",
      "type": "string"
    },
    "role": {
      "title": "Role",
      "type": "string"
    }
  },
  "required": [
    "actor",
    "role"
  ],
  "title": "WhoAmI",
  "type": "object"
}
