{
  "$defs": {
    "Place": {
      "additionalProperties": true,
      "description": "업무 자리 — BPM 프로세스(패키지 id)마다 하나. **회사는 적지 않는다** — 패키지의 회사다.",
      "properties": {
        "department": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Department"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "staff": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staff"
        }
      },
      "required": [
        "scope"
      ],
      "title": "Place",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c16-approve-request",
  "additionalProperties": true,
  "description": "`PUT /packages/{id}/{version}/signature`의 본문 (C16 — 지금까지는 본문이 없었다).\n\n그 BPM 프로세스에 자리가 **아직 없으면** `place`가 필요하다(`place_required`). 있으면 비워 두고,\n적으면 바꾼다. 공유 BPM 프로세스(`process_lib`)에는 적지 않는다.",
  "properties": {
    "place": {
      "anyOf": [
        {
          "$ref": "#/$defs/Place"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "ApproveRequest",
  "type": "object"
}
