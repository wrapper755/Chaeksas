{
  "$defs": {
    "AdminKey": {
      "additionalProperties": true,
      "description": "Admin 공개키 하나. 철회된 키도 `revoked_at`과 함께 내려온다 (C4로 배포된다).",
      "properties": {
        "key_id": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Key Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "public_key": {
          "title": "Public Key",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        }
      },
      "required": [
        "key_id",
        "public_key"
      ],
      "title": "AdminKey",
      "type": "object"
    },
    "ApprovalDispatch": {
      "additionalProperties": true,
      "description": "답이 정해진 결재 (C6).",
      "properties": {
        "answer": {
          "default": null,
          "title": "Answer"
        },
        "answered_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered At"
        },
        "answered_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered By"
        },
        "answered_via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered Via"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "state"
      ],
      "title": "ApprovalDispatch",
      "type": "object"
    },
    "DelegationResult": {
      "additionalProperties": true,
      "description": "끝난 PC 위임 하나 (C12 §PC 위임) — 하트비트 응답으로 내려간다.\n\n**`outputs`가 업무 값이다** — 원칙 6의 명시한 예외이고, 올라오는 것은 그 BPM 프로세스가 **선언한\n`outputs`만**이다 (C1). `state`가 `finished`가 아니면 실행기가 오류 경계로 넘긴다.",
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "outputs": {
          "additionalProperties": true,
          "title": "Outputs",
          "type": "object"
        },
        "pc_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pc Run Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "run_id",
        "state"
      ],
      "title": "DelegationResult",
      "type": "object"
    },
    "JobDispatch": {
      "additionalProperties": true,
      "description": "내려온 작업 하나. ack가 올 때까지 매번 실린다.",
      "properties": {
        "bpm_process_id": {
          "title": "Bpm Process Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaceIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested_at": {
          "title": "Requested At",
          "type": "string"
        },
        "requested_by": {
          "title": "Requested By",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "job_id",
        "bpm_process_id",
        "requested_by",
        "requested_at"
      ],
      "title": "JobDispatch",
      "type": "object"
    },
    "MessageDispatch": {
      "additionalProperties": true,
      "description": "내려온 메시지 하나 — 기다리는 실행을 깨우거나 메시지 시작으로 새 실행을 만든다.",
      "properties": {
        "correlation": {
          "default": null,
          "title": "Correlation"
        },
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "received_at": {
          "title": "Received At",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "name",
        "received_at"
      ],
      "title": "MessageDispatch",
      "type": "object"
    },
    "OrgRef": {
      "additionalProperties": true,
      "description": "조직 하나를 가리키는 id와 이름 — 실행하는 쪽이 값 출처로 푼다.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "OrgRef",
      "type": "object"
    },
    "PlaceIdentity": {
      "additionalProperties": true,
      "description": "**작업의 주인** — Center가 서버 작업을 내려줄 때 붙인다 (C12 `JobDispatch.place`). 저장하지 않는다.\n\n실행하는 쪽이 출처가 `company.*`·`department.*`·`staff.*`인 입력의 값으로 푼다\n(`core.engine.sourced_inputs`). 그 자리에 없는 것(회사 자리 업무의 직원)은 비어 있다.",
      "properties": {
        "company": {
          "$ref": "#/$defs/OrgRef"
        },
        "department": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrgRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "staff": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrgRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "company"
      ],
      "title": "PlaceIdentity",
      "type": "object"
    },
    "RotatedKey": {
      "additionalProperties": true,
      "description": "하트비트 답의 새 키 (C4 §키 회전). 새 키로 첫 요청이 올 때까지 주기마다 실린다.",
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "sealed_key": {
          "$ref": "#/$defs/Sealed"
        }
      },
      "required": [
        "sealed_key"
      ],
      "title": "RotatedKey",
      "type": "object"
    },
    "Sealed": {
      "additionalProperties": true,
      "description": "받는 쪽 공개키로만 열리는 한 덩이 (C4 §봉함).",
      "properties": {
        "alg": {
          "default": "x25519-hkdf-sha256-chacha20poly1305",
          "title": "Alg",
          "type": "string"
        },
        "ciphertext": {
          "title": "Ciphertext",
          "type": "string"
        },
        "epk": {
          "title": "Epk",
          "type": "string"
        },
        "nonce": {
          "title": "Nonce",
          "type": "string"
        }
      },
      "required": [
        "epk",
        "nonce",
        "ciphertext"
      ],
      "title": "Sealed",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c12-heartbeat-response",
  "additionalProperties": true,
  "description": "지시는 모두 여기 실려 내려온다 (ADR-0007).\n\n`deployments`는 **저장된 JSON 그대로** 다룬다 — C2 봉투를 모델로 바꿔 다시 직렬화하면\n서명이 깨진다 (C4와 같은 이유로 `dict`다).\n\n`jobs`는 **빈자리만큼만** 실린다 (C12 §Center가 작업을 나누는 규칙).",
  "properties": {
    "admin_keys": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AdminKey"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Admin Keys"
    },
    "approvals": {
      "items": {
        "$ref": "#/$defs/ApprovalDispatch"
      },
      "title": "Approvals",
      "type": "array"
    },
    "cancel_jobs": {
      "items": {
        "type": "string"
      },
      "title": "Cancel Jobs",
      "type": "array"
    },
    "delegations": {
      "items": {
        "$ref": "#/$defs/DelegationResult"
      },
      "title": "Delegations",
      "type": "array"
    },
    "deployments": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Deployments",
      "type": "array"
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/JobDispatch"
      },
      "title": "Jobs",
      "type": "array"
    },
    "key_expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key Expires At"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/MessageDispatch"
      },
      "title": "Messages",
      "type": "array"
    },
    "next_heartbeat_s": {
      "default": 10,
      "title": "Next Heartbeat S",
      "type": "integer"
    },
    "paused": {
      "default": false,
      "title": "Paused",
      "type": "boolean"
    },
    "restart": {
      "default": false,
      "title": "Restart",
      "type": "boolean"
    },
    "rotated_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/RotatedKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "server_time": {
      "title": "Server Time",
      "type": "string"
    }
  },
  "required": [
    "server_time"
  ],
  "title": "ServerRunnerHeartbeatResponse",
  "type": "object"
}
