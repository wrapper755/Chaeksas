          "$ref": "#/$defs/Runtimes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "description": "이 계약의 schema 번호",
      "title": "Schema",
      "type": "integer"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    }
  },
  "required": [
    "schema",
    "machine_id",
    "name",
    "os",
    "versions"
  ],
  "title": "RegisterRequest",
  "type": "object"
