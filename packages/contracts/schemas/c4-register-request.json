  "$id": "urn:chaeksas:contracts:c4-register-request",
  "additionalProperties": true,
  "description": "`POST /api/v1/bot-ui/register` — 처음 한 번, 그리고 이름·버전이 바뀔 때.\n\n`bot_ui_id`를 본문에 넣지 않는다. **신원은 Center API 키로 정한다.**",
  "properties": {
    "machine_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Machine Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "os": {
      "title": "Os",
      "type": "string"
    },
    "runtimes": {
