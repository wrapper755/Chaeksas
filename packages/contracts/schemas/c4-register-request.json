{
  "$defs": {
    "BuildStamp": {
      "additionalProperties": true,
      "description": "묶은 산출물의 표시 (C4 `versions.build`, [ADR-0067](../../../../../docs/decisions/0067-build-stamp.md)).\n\n**있으면 묶은 것에서 돈다.** 없으면 묶지 않은 것(소스·`uv sync`)이다 — 「모른다」가 아니다.\n판 자체는 `Versions.bot_ui`에 있다(빌드가 찍은 것).",
      "properties": {
        "built_at": {
          "title": "Built At",
          "type": "string"
        },
        "commit": {
          "title": "Commit",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "built_at"
      ],
      "title": "BuildStamp",
      "type": "object"
    },
    "ExtensionState": {
      "additionalProperties": true,
      "description": "설치된 확장 하나 (C13).\n\n**`enabled`와 `off`는 다른 것을 말한다** ([ADR-0043](../../../../../docs/decisions/0043-turned-off-extensions.md)):\n`off`는 **사람이 껐다**(멀쩡한데 일부러 안 쓴다), `enabled=false`인데 `off`가 아니면 **흠이\n있다**(정의·판이 맞지 않는다). 화면이 「꺼짐」과 「호환 안 됨」을 가르는 자리다. 뜻을 바꾸지\n않고 칸을 더한 것이라 옛 Bot UI가 보낸 값(`off` 없음)도 그대로 읽힌다.",
      "properties": {
        "definition_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Hash"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "off": {
          "default": false,
          "title": "Off",
          "type": "boolean"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ExtensionState",
      "type": "object"
    },
    "Runtimes": {
      "additionalProperties": true,
      "properties": {
        "browsers": {
          "items": {
            "type": "string"
          },
          "title": "Browsers",
          "type": "array"
        },
        "desktop_backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Desktop Backend"
        },
        "extensions": {
          "items": {
            "$ref": "#/$defs/ExtensionState"
          },
          "title": "Extensions",
          "type": "array"
        }
      },
      "title": "Runtimes",
      "type": "object"
    },
    "Versions": {
      "additionalProperties": true,
      "properties": {
        "bot_ui": {
          "title": "Bot Ui",
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildStamp"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "core": {
          "title": "Core",
          "type": "string"
        },
        "worker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker"
        }
      },
      "required": [
        "bot_ui",
        "core"
      ],
      "title": "Versions",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c4-register-request",
  "additionalProperties": true,
  "description": "`POST /api/v1/bot-ui/register` — 처음 한 번, 그리고 이름·버전이 바뀔 때.\n\n`bot_ui_id`를 본문에 넣지 않는다. **신원은 Center API 키로 정한다.**",
  "properties": {
    "machine_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Machine Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "os": {
      "title": "Os",
      "type": "string"
    },
    "runtimes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Runtimes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema": {
      "description": "이 계약의 schema 번호",
      "title": "Schema",
      "type": "integer"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    }
  },
  "required": [
    "schema",
    "machine_id",
    "name",
    "os",
    "versions"
  ],
  "title": "RegisterRequest",
  "type": "object"
}
