{
  "$defs": {
    "Built": {
      "additionalProperties": true,
      "description": "누가 언제 무엇으로 빌드했나.",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "by": {
          "title": "By",
          "type": "string"
        },
        "core": {
          "title": "Core",
          "type": "string"
        },
        "spec_version": {
          "title": "Spec Version",
          "type": "integer"
        }
      },
      "required": [
        "by",
        "at",
        "core",
        "spec_version"
      ],
      "title": "Built",
      "type": "object"
    },
    "ExtensionNeed": {
      "additionalProperties": true,
      "description": "쓰는 확장과 버전 범위 (C13). 외부 확장은 `definition_hash`로 정의를 고정한다.",
      "properties": {
        "definition_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition Hash"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ExtensionNeed",
      "type": "object"
    },
    "HumanNeeds": {
      "additionalProperties": true,
      "description": "사람 개입 종류. 서버 실행 가능 여부(R2) 판정에 쓴다.",
      "properties": {
        "approval_center": {
          "default": false,
          "title": "Approval Center",
          "type": "boolean"
        },
        "approval_field": {
          "default": false,
          "title": "Approval Field",
          "type": "boolean"
        },
        "confirmation": {
          "default": false,
          "title": "Confirmation",
          "type": "boolean"
        }
      },
      "title": "HumanNeeds",
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": true,
      "description": "패키지 매니페스트 (C1 최상위).\n\n`kind=\"bpm_process\"`이고 `run_location`이 없으면 **`server`로 채운다** (서버 우선, 호환 규칙).",
      "properties": {
        "built": {
          "$ref": "#/$defs/Built"
        },
        "content_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "entry": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry"
        },
        "human": {
          "$ref": "#/$defs/HumanNeeds"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$",
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ManifestInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "kind": {
          "enum": [
            "bpm_process",
            "process_lib"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "process_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Id"
        },
        "provides": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provides"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requires": {
          "$ref": "#/$defs/Requires"
        },
        "run_location": {
          "anyOf": [
            {
              "enum": [
                "server",
                "pc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Location"
        },
        "schema": {
          "description": "이 계약의 schema 번호",
          "title": "Schema",
          "type": "integer"
        },
        "triggers": {
          "items": {
            "$ref": "#/$defs/Trigger"
          },
          "title": "Triggers",
          "type": "array"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "kind",
        "id",
        "version",
        "requires",
        "human",
        "built",
        "content_hash"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "ManifestInput": {
      "additionalProperties": true,
      "description": "진입 정의가 받는 입력 하나 — `bpm:process.inputs`를 옮긴 것 (C1). 작업 지시 화면이 칸을 그린다.",
      "properties": {
        "default": {
          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ManifestInput",
      "type": "object"
    },
    "MissingResource": {
      "additionalProperties": true,
      "description": "패키지가 쓰는데 Center 리소스 목록에 없는(또는 맞지 않는) 것 하나.\n\nC5 `PackageInfo.missing_resources`에 실린다.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "reason"
      ],
      "title": "MissingResource",
      "type": "object"
    },
    "Place": {
      "additionalProperties": true,
      "description": "업무 자리 — BPM 프로세스(패키지 id)마다 하나. **회사는 적지 않는다** — 패키지의 회사다.",
      "properties": {
        "department": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Department"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "staff": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staff"
        }
      },
      "required": [
        "scope"
      ],
      "title": "Place",
      "type": "object"
    },
    "PreflightSummary": {
      "additionalProperties": true,
      "description": "Studio가 계산한 사전 점검 요약. 값은 코드 목록이다 (C4 `Readiness.blocked`와 같은 결).",
      "properties": {
        "blocked": {
          "items": {
            "type": "string"
          },
          "title": "Blocked",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "title": "PreflightSummary",
      "type": "object"
    },
    "ProvidedProcess": {
      "additionalProperties": true,
      "description": "`process_lib`이 제공하는 공유 BPM 프로세스 하나.",
      "properties": {
        "ai_tasks": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Tasks"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "human": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanNeeds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "process_id": {
          "title": "Process Id",
          "type": "string"
        },
        "reads": {
          "items": {
            "type": "string"
          },
          "title": "Reads",
          "type": "array"
        },
        "run_location": {
          "anyOf": [
            {
              "enum": [
                "server",
                "pc"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Location"
        },
        "writes": {
          "items": {
            "type": "string"
          },
          "title": "Writes",
          "type": "array"
        }
      },
      "required": [
        "process_id",
        "file"
      ],
      "title": "ProvidedProcess",
      "type": "object"
    },
    "Provides": {
      "additionalProperties": true,
      "properties": {
        "processes": {
          "items": {
            "$ref": "#/$defs/ProvidedProcess"
          },
          "title": "Processes",
          "type": "array"
        }
      },
      "title": "Provides",
      "type": "object"
    },
    "Requires": {
      "additionalProperties": true,
      "description": "실행에 필요한 것. 모두 선택이고, 없으면 \"제한 없음\"이다.",
      "properties": {
        "core": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Core"
        },
        "delegations": {
          "items": {
            "type": "string"
          },
          "title": "Delegations",
          "type": "array"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "title": "Domains",
          "type": "array"
        },
        "extensions": {
          "items": {
            "$ref": "#/$defs/ExtensionNeed"
          },
          "title": "Extensions",
          "type": "array"
        },
        "libs": {
          "items": {
            "type": "string"
          },
          "title": "Libs",
          "type": "array"
        },
        "os": {
          "items": {
            "type": "string"
          },
          "title": "Os",
          "type": "array"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Resources",
          "type": "array"
        },
        "runtimes": {
          "items": {
            "type": "string"
          },
          "title": "Runtimes",
          "type": "array"
        },
        "service_apps": {
          "items": {
            "$ref": "#/$defs/ServiceAppNeed"
          },
          "title": "Service Apps",
          "type": "array"
        },
        "settings": {
          "items": {
            "type": "string"
          },
          "title": "Settings",
          "type": "array"
        },
        "task_types": {
          "items": {
            "$ref": "#/$defs/TaskTypeNeed"
          },
          "title": "Task Types",
          "type": "array"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "Requires",
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": true,
      "description": "확장이 기여한 자원 중 쓰는 것 (예: `{type: \"ui_page\", id: \"erp.order.form\"}`).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "ServiceAppNeed": {
      "additionalProperties": true,
      "description": "부르는 서비스 앱(= C15 토픽)과 작업. **키도 키 참조도 없다** (ADR-0102).\n\n옛 패키지의 `key_ref`·`task_key_refs`는 모르는 칸으로 받아 두고 보지 않는다 (원칙 3).",
      "properties": {
        "app_id": {
          "title": "App Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        }
      },
      "required": [
        "app_id",
        "operations"
      ],
      "title": "ServiceAppNeed",
      "type": "object"
    },
    "TaskTypeNeed": {
      "additionalProperties": true,
      "description": "확장이 기여한 태스크 종류와, 그 확장 정의에 적힌 실행 위치. R2 판정에 쓴다.",
      "properties": {
        "extension": {
          "title": "Extension",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "run_locations": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Locations"
        }
      },
      "required": [
        "id",
        "extension"
      ],
      "title": "TaskTypeNeed",
      "type": "object"
    },
    "Trigger": {
      "additionalProperties": true,
      "description": "시작 방법 — 진입 정의의 시작 이벤트 하나를 옮긴 것.\n\n`kind`는 `KNOWN_TRIGGER_KINDS` 중 하나다. 타입이 아니라 **R9**가 검사한다 — 위반에\n`unknown_trigger_kind` 코드를 붙여 Studio·Center가 같은 문구로 말하려고 (R4와 같은 결).\n\n**이름과 식은 다른 칸이다** — `name`은 이벤트 이름(C12 메시지 API가 이 이름으로 보낸다),\n`expression`은 타이머 식(`timeCycle`의 cron·ISO)이다. 한 칸에 담으면 읽는 쪽이 타이머\n트리거의 `name`을 메시지 이름으로 읽는다.",
      "properties": {
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c5-package-info",
  "additionalProperties": true,
  "description": "`GET /packages`의 한 줄, `POST /packages`의 응답.",
  "properties": {
    "approved_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved By"
    },
    "company": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "download_count": {
      "default": 0,
      "minimum": 0,
      "title": "Download Count",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "last_downloaded_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Downloaded At"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Manifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "missing_resources": {
      "items": {
        "$ref": "#/$defs/MissingResource"
      },
      "title": "Missing Resources",
      "type": "array"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "place": {
      "anyOf": [
        {
          "$ref": "#/$defs/Place"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preflight": {
      "$ref": "#/$defs/PreflightSummary"
    },
    "run_location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Location"
    },
    "signed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed At"
    },
    "signed_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signed By"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "uploaded_at": {
      "title": "Uploaded At",
      "type": "string"
    },
    "uploaded_by": {
      "title": "Uploaded By",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "kind",
    "status",
    "content_hash",
    "uploaded_by",
    "uploaded_at"
  ],
  "title": "PackageInfo",
  "type": "object"
}
