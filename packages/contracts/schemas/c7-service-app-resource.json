{
  "$defs": {
    "Operation": {
      "additionalProperties": true,
      "description": "작업 하나. Studio가 이것만 보고 서비스 앱 태스크 편집기(STU-14)를 만든다.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fallback": {
          "default": "none",
          "title": "Fallback",
          "type": "string"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema"
        },
        "modes": {
          "items": {
            "type": "string"
          },
          "title": "Modes",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "required_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Required Scopes",
          "type": "array"
        },
        "server_ok": {
          "default": true,
          "title": "Server Ok",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 60,
          "title": "Timeout S",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "Operation",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c7-service-app-resource",
  "additionalProperties": true,
  "description": "서비스 앱 하나 (확장의 서버 부분).",
  "properties": {
    "app_id": {
      "title": "App Id",
      "type": "string"
    },
    "base_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Base Url"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked At"
    },
    "console_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Console Url"
    },
    "extension_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extension Id"
    },
    "manifest_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest At"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "title": "Operations",
      "type": "array"
    },
    "status": {
      "default": "unknown",
