      "type": "string"
    },
    "status_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Status Reasons",
      "type": "array"
    },
    "used_by": {
      "items": {
        "type": "string"
      },
      "title": "Used By",
      "type": "array"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    }
  },
  "required": [
    "app_id"
  ],
  "title": "ServiceAppResource",
  "type": "object"
}
