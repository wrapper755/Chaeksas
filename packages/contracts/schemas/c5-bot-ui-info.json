  "$id": "urn:chaeksas:contracts:c5-bot-ui-info",
  "additionalProperties": true,
  "description": "`GET /bot-uis`의 한 줄 (CON-03).\n\n상태 값은 **Bot UI가 하트비트로 보고한 그대로**다 (C4). Center가 더하는 것은 온라인\n판정(`online`)과 키 정보(`key`)뿐이다.",
  "properties": {
    "bot_ui_id": {
      "title": "Bot Ui Id",
      "type": "string"
    },
    "current_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/CurrentRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deployment_results": {
      "items": {
        "$ref": "#/$defs/DeploymentResult"
      },
      "title": "Deployment Results",
      "type": "array"
    },
    "disabled": {
      "default": false,
      "title": "Disabled",
      "type": "boolean"
    },
    "extensions": {
      "items": {
        "$ref": "#/$defs/ExtensionState"
      },
      "title": "Extensions",
      "type": "array"
    },
    "key": {
      "anyOf": [
        {
          "$ref": "#/$defs/BotUiKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_seen_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Seen At"
    },
    "machine_id": {
      "title": "Machine Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "online": {
      "default": false,
      "title": "Online",
      "type": "boolean"
    },
    "os": {
      "title": "Os",
      "type": "string"
    },
    "queue": {
      "anyOf": [
        {
          "$ref": "#/$defs/Queue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "readiness": {
      "items": {
        "$ref": "#/$defs/Readiness"
      },
      "title": "Readiness",
      "type": "array"
    },
    "registered_at": {
      "title": "Registered At",
      "type": "string"
    },
    "runtimes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Runtimes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    },
    "worker": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkerState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
