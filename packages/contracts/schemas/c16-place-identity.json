{
  "$defs": {
    "OrgRef": {
      "additionalProperties": true,
      "description": "조직 하나를 가리키는 id와 이름 — 실행하는 쪽이 값 출처로 푼다.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "OrgRef",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c16-place-identity",
  "additionalProperties": true,
  "description": "**작업의 주인** — Center가 서버 작업을 내려줄 때 붙인다 (C12 `JobDispatch.place`). 저장하지 않는다.\n\n실행하는 쪽이 출처가 `company.*`·`department.*`·`staff.*`인 입력의 값으로 푼다\n(`core.engine.sourced_inputs`). 그 자리에 없는 것(회사 자리 업무의 직원)은 비어 있다.",
  "properties": {
    "company": {
      "$ref": "#/$defs/OrgRef"
    },
    "department": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrgRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "staff": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrgRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "company"
  ],
  "title": "PlaceIdentity",
  "type": "object"
}
