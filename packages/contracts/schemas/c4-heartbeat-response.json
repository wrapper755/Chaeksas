{
  "$defs": {
    "AdminKey": {
      "additionalProperties": true,
      "description": "Admin 공개키 하나. 철회된 키도 `revoked_at`과 함께 내려온다 (C4로 배포된다).",
      "properties": {
        "key_id": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Key Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "public_key": {
          "title": "Public Key",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        }
      },
      "required": [
        "key_id",
        "public_key"
      ],
      "title": "AdminKey",
      "type": "object"
    },
    "ApprovalDispatch": {
      "additionalProperties": true,
      "description": "답이 정해진 결재 (C6).",
      "properties": {
        "answer": {
          "default": null,
          "title": "Answer"
        },
        "answered_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered At"
        },
        "answered_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered By"
        },
        "answered_via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answered Via"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "state"
      ],
      "title": "ApprovalDispatch",
      "type": "object"
    },
    "JobDispatch": {
      "additionalProperties": true,
      "description": "내려온 작업 하나. ack가 올 때까지 매번 실린다.",
      "properties": {
        "bpm_process_id": {
          "title": "Bpm Process Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "place": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaceIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested_at": {
          "title": "Requested At",
          "type": "string"
        },
        "requested_by": {
          "title": "Requested By",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "job_id",
        "bpm_process_id",
        "requested_by",
        "requested_at"
      ],
      "title": "JobDispatch",
      "type": "object"
    },
    "OrgRef": {
      "additionalProperties": true,
      "description": "조직 하나를 가리키는 id와 이름 — 실행하는 쪽이 값 출처로 푼다.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "OrgRef",
      "type": "object"
    },
    "PlaceIdentity": {
      "additionalProperties": true,
      "description": "**작업의 주인** — Center가 서버 작업을 내려줄 때 붙인다 (C12 `JobDispatch.place`). 저장하지 않는다.\n\n실행하는 쪽이 출처가 `company.*`·`department.*`·`staff.*`인 입력의 값으로 푼다\n(`core.engine.sourced_inputs`). 그 자리에 없는 것(회사 자리 업무의 직원)은 비어 있다.",
      "properties": {
        "company": {
          "$ref": "#/$defs/OrgRef"
        },
        "department": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrgRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "staff": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrgRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "company"
      ],
      "title": "PlaceIdentity",
      "type": "object"
    },
    "RotatedKey": {
      "additionalProperties": true,
      "description": "하트비트 답의 새 키 (C4 §키 회전). 새 키로 첫 요청이 올 때까지 주기마다 실린다.",
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "sealed_key": {
          "$ref": "#/$defs/Sealed"
        }
      },
      "required": [
        "sealed_key"
      ],
      "title": "RotatedKey",
      "type": "object"
    },
    "Sealed": {
      "additionalProperties": true,
      "description": "받는 쪽 공개키로만 열리는 한 덩이 (C4 §봉함).",
      "properties": {
        "alg": {
          "default": "x25519-hkdf-sha256-chacha20poly1305",
          "title": "Alg",
          "type": "string"
        },
        "ciphertext": {
          "title": "Ciphertext",
          "type": "string"
        },
        "epk": {
          "title": "Epk",
          "type": "string"
        },
        "nonce": {
          "title": "Nonce",
          "type": "string"
        }
      },
      "required": [
        "epk",
        "nonce",
        "ciphertext"
      ],
      "title": "Sealed",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c4-heartbeat-response",
  "additionalProperties": true,
  "description": "하트비트 응답 — 지시는 모두 여기 실려 내려온다 (ADR-0007).\n\n`deployments`는 **저장된 JSON 그대로** 다룬다. C2 봉투를 모델로 바꿔 다시 직렬화하면\n`canonical_json`이 달라져 서명이 깨지므로, 일부러 `dict`로 둔다.",
  "properties": {
    "admin_keys": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/AdminKey"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Admin Keys"
    },
    "approvals": {
      "items": {
        "$ref": "#/$defs/ApprovalDispatch"
      },
      "title": "Approvals",
      "type": "array"
    },
    "cancel_jobs": {
      "items": {
        "type": "string"
      },
      "title": "Cancel Jobs",
      "type": "array"
    },
    "deployments": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Deployments",
      "type": "array"
    },
    "disabled": {
      "default": false,
      "title": "Disabled",
      "type": "boolean"
    },
    "jobs": {
      "items": {
        "$ref": "#/$defs/JobDispatch"
      },
      "title": "Jobs",
      "type": "array"
    },
    "key_expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key Expires At"
    },
    "next_heartbeat_s": {
      "default": 30,
      "title": "Next Heartbeat S",
      "type": "integer"
    },
    "rotated_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/RotatedKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "server_time": {
      "title": "Server Time",
      "type": "string"
    }
  },
  "required": [
    "server_time"
  ],
  "title": "HeartbeatResponse",
  "type": "object"
}
