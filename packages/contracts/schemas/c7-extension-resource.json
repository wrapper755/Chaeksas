          "type": "integer"
        }
      },
      "title": "InstalledOn",
      "type": "object"
    },
    "KeySlot": {
      "additionalProperties": true,
      "description": "관리자가 넣은 외부 앱 키 한 칸 (C7 §외부 앱 키). **원문·앞자리는 없다.**",
