{
  "$defs": {
    "ExtensionRef": {
      "additionalProperties": true,
      "description": "이 서비스 앱이 어느 확장의 서버 부분인가 (C13). 내장·사내 확장이면 넣는다.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ExtensionRef",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": true,
      "description": "작업 하나. Studio가 이것만 보고 서비스 앱 태스크 편집기(STU-14)를 만든다.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fallback": {
          "default": "none",
          "title": "Fallback",
          "type": "string"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema"
        },
        "modes": {
          "items": {
            "type": "string"
          },
          "title": "Modes",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "server_ok": {
          "default": true,
          "title": "Server Ok",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 60,
          "title": "Timeout S",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "Operation",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c11-service-app-manifest",
  "additionalProperties": true,
  "description": "`GET /manifest` — 인증 없음 (비밀이 없다). Center가 리소스 목록에 쓴다 (C7).",
  "properties": {
    "app_id": {
      "title": "App Id",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "console_url": {
      "title": "Console Url",
      "type": "string"
    },
    "extension": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "title": "Operations",
      "type": "array"
    },
    "schema": {
      "description": "이 계약의 schema 번호",
      "title": "Schema",
      "type": "integer"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "app_id",
    "name",
    "version",
    "category",
    "console_url"
  ],
  "title": "ServiceAppManifest",
  "type": "object"
}
