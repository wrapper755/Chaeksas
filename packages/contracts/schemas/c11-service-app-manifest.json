{
  "$defs": {
    "ExtensionRef": {
      "additionalProperties": true,
      "description": "이 서비스 앱이 어느 확장의 서버 부분인가 (C13). 내장·사내 확장이면 넣는다.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ExtensionRef",
      "type": "object"
    },
    "Operation": {
      "additionalProperties": true,
      "description": "작업 하나. Studio가 이것만 보고 서비스 앱 태스크 편집기(STU-14)를 만든다.",
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "fallback": {
          "default": "none",
          "title": "Fallback",
          "type": "string"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema"
        },
        "modes": {
          "items": {
            "type": "string"
          },
          "title": "Modes",
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "output_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Schema"
        },
        "required_scopes": {
          "items": {
            "type": "string"
          },
          "title": "Required Scopes",
          "type": "array"
        },
        "server_ok": {
          "default": true,
          "title": "Server Ok",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 60,
          "title": "Timeout S",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "Operation",
      "type": "object"
    },
    "ResourceCatalog": {
      "additionalProperties": true,
      "description": "이 앱이 **자기 기여 자원 카탈로그**를 내는 종류 (C7 §리소스 모으는 방식).\n\n**내장·사내 확장의 정의는 Center에 없어**(설치 파일에 들어 있다) 서버 부분이 자기 카탈로그를\n알린다 — 일꾼이 `PUT /consumers/self/catalogs/{type}`으로 올린다 (C15, ADR-0102). 응답 형식은\nC13 §5 `Catalog`다. `catalog_url`은 옛 manifest를 읽기 위해 남은 칸이고 Center는 그 주소를 부르지 않는다.",
      "properties": {
        "catalog_url": {
          "title": "Catalog Url",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "catalog_url"
      ],
      "title": "ResourceCatalog",
      "type": "object"
    }
  },
  "$id": "urn:chaeksas:contracts:c11-service-app-manifest",
  "additionalProperties": true,
  "description": "앱이 하는 일 — 일꾼이 `PUT /consumers/self/manifest`로 올리고 Center가 리소스 목록·작업 대조에 쓴다 (C7·C15).",
  "properties": {
    "app_id": {
      "title": "App Id",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "console_url": {
      "title": "Console Url",
      "type": "string"
    },
    "extension": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "title": "Operations",
      "type": "array"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/ResourceCatalog"
      },
      "title": "Resources",
      "type": "array"
    },
    "schema": {
      "description": "이 계약의 schema 번호",
      "title": "Schema",
      "type": "integer"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "app_id",
    "name",
    "version",
    "category",
    "console_url"
  ],
  "title": "ServiceAppManifest",
  "type": "object"
}
