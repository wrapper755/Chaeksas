{
  "$id": "urn:chaeksas:contracts:c5-deployment-info",
  "additionalProperties": true,
  "description": "`GET /deployments`의 한 줄. 봉투 자체가 아니라 Center가 정리한 모양이다.\n\n실행하는 쪽에 내려갈 때는 **저장된 봉투 그대로** 간다 (C4 `deployments[]`).",
  "properties": {
    "bpm_process_id": {
      "title": "Bpm Process Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "deployment_id": {
      "title": "Deployment Id",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "last_result": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Result"
    },
    "max_concurrency": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Concurrency"
    },
    "not_before": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Not Before"
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revoked At"
    },
    "signed_at": {
      "title": "Signed At",
      "type": "string"
    },
    "signed_by": {
      "title": "Signed By",
      "type": "string"
    },
    "target": {
      "additionalProperties": true,
      "title": "Target",
      "type": "object"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "deployment_id",
    "target",
    "bpm_process_id",
    "version",
    "content_hash",
    "signed_by",
    "signed_at"
  ],
  "title": "DeploymentInfo",
  "type": "object"
}
