/* 생성 파일: design/tokens.json에서 만든다. 직접 고치지 말고 원본을 고친 뒤 scripts/gen_tokens.py (light) */

QWidget {
  background-color: #F3F4F7;
  color: #0A0A0A;
  font-family: Geist, "Pretendard Variable", Pretendard, "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
  font-size: 14px;
}

QFrame#Surface, QGroupBox, QDialog {
  background-color: #FFFFFF;
  border: 1px solid #D5D5D5;
  border-radius: 8px;
}

/* 묶음(Section, 스타일 가이드 §3) — 제목은 **카드 안쪽 맨 위**에, 굵게 + 왼쪽 강조 막대.
   테두리에 걸친 회색 제목은 내용과 붙어 보여 묶음이 갈리지 않았다. Qt는 제목 자리를 비워 주지
   않으므로 위 패딩 = 제목 위 여백 + 제목 줄 높이 + 제목 아래 간격으로 직접 연다 (없으면 겹친다, 이슈 #3). */
QGroupBox {
  margin-top: 0;
  font-size: 16px;
  font-weight: 700;
  padding: 45px 8px 8px 8px;
}
QGroupBox::title {
  subcontrol-origin: padding;
  subcontrol-position: top left;
  left: 12px;
  top: 12px;
  padding: 0 0 0 8px;
  border-left: 3px solid #5152C1;
  color: #0A0A0A;
}

/* QWidget 배경이 글자 위젯에도 칠해져 흰 상자 안에 회색 칸이 생긴다 — 글자는 놓인 곳의 배경을 따른다. */
QLabel, QCheckBox, QRadioButton { background-color: transparent; }

QLabel#Secondary { color: #45484D; }
QLabel#Muted { color: #656565; }

/* 글자의 뜻은 `role` 속성으로 준다 (스타일 가이드 §4-2) — 「빨간 글자로 이유」(U3)가 여기서 빨갛다. */
QLabel[role="error"] { color: #B42318; }
QLabel[role="warning"] { color: #92400E; }
QLabel[role="muted"] { color: #656565; }
QLabel[role="h2"] { font-size: 20px; font-weight: 600; }

QPushButton {
  background-color: #5152C1;
  color: #FFFFFF;
  border: none;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 12px;
  font-weight: 500;
}
QPushButton:hover { background-color: #423FAD; }
QPushButton:focus { border: 2px solid #757CD3; }
QPushButton:disabled { background-color: #E8E8E8; color: #656565; }

QPushButton#Secondary {
  background-color: #FFFFFF;
  color: #0A0A0A;
  border: 1px solid #AEAEAE;
}

QPushButton#Danger {
  background-color: #DC2626;
  color: #FFFFFF;
}

QToolButton[running="true"] {
  background-color: #5152C1;
  color: #FFFFFF;
  border-radius: 6px;
}

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QSpinBox {
  background-color: #FFFFFF;
  color: #0A0A0A;
  border: 1px solid #AEAEAE;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 8px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
  border: 2px solid #757CD3;
}

/* QSpinBox에 테두리·둥근 모서리를 입히면 기본 ▲▼ 단추가 그 테두리 위에 그대로 겹쳐 잘린다 (이슈 #3, 150%).
   단추를 테두리 안쪽에 세로로 놓고, 칸 오른쪽에 그 자리를 비운다. */
QSpinBox { padding-right: 24px; }
QSpinBox::up-button, QSpinBox::down-button {
  subcontrol-origin: border;
  width: 20px;
  border: none;
  border-left: 1px solid #D5D5D5;
  background-color: transparent;
}
QSpinBox::up-button {
  subcontrol-position: top right;
  margin: 1px 1px 0 0;
  border-top-right-radius: 6px;
}
QSpinBox::down-button {
  subcontrol-position: bottom right;
  margin: 0 1px 1px 0;
  border-bottom-right-radius: 6px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #E8E8E8; }
/* 단추를 꾸미면 Qt가 기본 화살표를 그리지 않는다 — 생성한 SVG를 쓴다. `@THEME_DIR@`는 테마를 읽을 때
   그 패키지 폴더의 실제 경로로 바뀐다 (chaeksas.qt.theme.qss). */
QSpinBox::up-arrow {
  image: url(@THEME_DIR@/arrow-up-light.svg);
  width: 8px;
  height: 4px;
}
QSpinBox::down-arrow {
  image: url(@THEME_DIR@/arrow-down-light.svg);
  width: 8px;
  height: 4px;
}

/* QCheckBox·QRadioButton에 **무엇이든** 스타일을 주면 Qt가 기본 표시기를 그리지 않는다 — 체크된 칸이
   상자 없이 ✓만 보였다 (이슈 #3). 표시기를 직접 그린다. ✓는 생성한 SVG다. */
QCheckBox::indicator, QRadioButton::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #AEAEAE;
  background-color: #FFFFFF;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }  /* 지름의 절반 = 동그라미 */
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #5152C1; }
QCheckBox::indicator:checked {
  background-color: #5152C1;
  border-color: #5152C1;
  image: url(@THEME_DIR@/check-light.svg);
}
QRadioButton::indicator:checked {
  background-color: #FFFFFF;
  border-color: #5152C1;
  image: url(@THEME_DIR@/dot-light.svg);
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  background-color: #E8E8E8;
  border-color: #D5D5D5;
}

QHeaderView::section {
  background-color: #E8E8E8;
  color: #45484D;
  border: none;
  border-bottom: 1px solid #D5D5D5;
  height: 32px;
  padding: 0 8px;
}
QTableView, QTreeView, QListView {
  background-color: #FFFFFF;
  alternate-background-color: #F3F4F7;
  border: 1px solid #D5D5D5;
  border-radius: 8px;
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
  background-color: #E6EAFF;
  color: #0A0A0A;
}

/* 작업 영역(STU-01) — 영역마다 카드(흰 바탕 + 테두리)이고 사이는 바탕색 틈이 가른다. 선을 긋지 않는다
   (선은 옆 영역의 테두리와 겹쳐 두 겹이 된다). 틈이 곧 끌어서 크기를 바꾸는 자리다. */
QSplitter::handle, QMainWindow::separator { background-color: transparent; }
QSplitter::handle:horizontal, QMainWindow::separator:horizontal { width: 8px; }
QSplitter::handle:vertical, QMainWindow::separator:vertical { height: 8px; }
QFrame#Pane, QTabWidget#PaneTabs::pane {
  background-color: #FFFFFF;
  border: 1px solid #D5D5D5;
  border-radius: 8px;
}
QTabWidget#PaneTabs::pane { top: -1px; border-top-left-radius: 0; }
/* 카드 안의 첫 목록은 카드의 테두리를 쓴다 — 제 테두리를 또 그리면 두 겹이다. */
QTabWidget#PaneTabs > QStackedWidget > QAbstractScrollArea,
QTabWidget#PaneTabs > QStackedWidget > QWidget > QAbstractScrollArea {
  border: none;
  border-radius: 0;
}

/* 무리 아래 선 (STU-01 「변수」 탭) — 작은 탭과 그 아래 표를 가른다. */
QFrame#Rule { background-color: #D5D5D5; border: none; max-height: 1px; min-height: 1px; }

/* 펼친 메뉴(메뉴 막대·문맥 메뉴) — 테두리가 없으면 흰 바탕 위에서 메뉴가 어디까지인지 안 보인다. */
QMenu {
  background-color: #FFFFFF;
  color: #0A0A0A;
  border: 1px solid #AEAEAE;
  padding: 4px 0;
}
QMenu::item { padding: 4px 24px 4px 12px; }
QMenu::item:selected { background-color: #5152C1; color: #FFFFFF; }
QMenu::item:disabled { color: #656565; }
QMenu::separator { height: 1px; background-color: #D5D5D5; margin: 4px 8px; }

QToolTip {
  background-color: #0A0A0A;
  color: #FFFFFF;
  border: none;
  padding: 4px 8px;
}

QProgressBar {
  background-color: #E8E8E8;
  border: none;
  border-radius: 9999px;
  height: 8px;
  text-align: center;
}
QProgressBar::chunk { background-color: #2563EB; border-radius: 9999px; }
