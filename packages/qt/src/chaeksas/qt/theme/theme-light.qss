/* 생성 파일: design/tokens.json에서 만든다. 직접 고치지 말고 원본을 고친 뒤 scripts/gen_tokens.py (light) */

QWidget {
  background-color: #F6F7F9;
  color: #1A1D23;
  font-family: "Pretendard Variable", Pretendard, "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
  font-size: 14px;
}

QFrame#Surface, QGroupBox, QDialog {
  background-color: #FFFFFF;
  border: 1px solid #DDE1E6;
  border-radius: 8px;
}

/* QGroupBox에 테두리를 입히면 Qt가 제목 자리를 비워 주지 않는다 — 여백과 ::title을 직접 정한다.
   없으면 제목이 첫 줄과 겹친다 (이슈 #3). */
QGroupBox {
  margin-top: 16px;
  padding: 12px 8px 8px 8px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 12px;
  padding: 0 4px;
  color: #4A5361;
  font-weight: 600;
}

/* QWidget 배경이 글자 위젯에도 칠해져 흰 상자 안에 회색 칸이 생긴다 — 글자는 놓인 곳의 배경을 따른다. */
QLabel, QCheckBox, QRadioButton { background-color: transparent; }

QLabel#Secondary { color: #4A5361; }
QLabel#Muted { color: #5F6875; }

QPushButton {
  background-color: #2552C7;
  color: #FFFFFF;
  border: none;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 12px;
  font-weight: 500;
}
QPushButton:hover { background-color: #1D44A8; }
QPushButton:focus { border: 2px solid #2552C7; }
QPushButton:disabled { background-color: #EEF0F3; color: #5F6875; }

QPushButton#Secondary {
  background-color: #FFFFFF;
  color: #1A1D23;
  border: 1px solid #B9C0CA;
}

QPushButton#Danger {
  background-color: #DC2626;
  color: #FFFFFF;
}

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QSpinBox {
  background-color: #FFFFFF;
  color: #1A1D23;
  border: 1px solid #B9C0CA;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 8px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
  border: 2px solid #2552C7;
}

/* QSpinBox에 테두리·둥근 모서리를 입히면 기본 ▲▼ 단추가 그 테두리 위에 그대로 겹쳐 잘린다 (이슈 #3, 150%).
   단추를 테두리 안쪽에 세로로 놓고, 칸 오른쪽에 그 자리를 비운다. */
QSpinBox { padding-right: 24px; }
QSpinBox::up-button, QSpinBox::down-button {
  subcontrol-origin: border;
  width: 20px;
  border: none;
  border-left: 1px solid #DDE1E6;
  background-color: transparent;
}
QSpinBox::up-button {
  subcontrol-position: top right;
  margin: 1px 1px 0 0;
  border-top-right-radius: 6px;
}
QSpinBox::down-button {
  subcontrol-position: bottom right;
  margin: 0 1px 1px 0;
  border-bottom-right-radius: 6px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #EEF0F3; }
/* 단추를 꾸미면 Qt가 기본 화살표를 그리지 않는다 — 생성한 SVG를 쓴다. `@THEME_DIR@`는 테마를 읽을 때
   그 패키지 폴더의 실제 경로로 바뀐다 (chaeksas.qt.theme.qss). */
QSpinBox::up-arrow {
  image: url(@THEME_DIR@/arrow-up-light.svg);
  width: 8px;
  height: 4px;
}
QSpinBox::down-arrow {
  image: url(@THEME_DIR@/arrow-down-light.svg);
  width: 8px;
  height: 4px;
}

QHeaderView::section {
  background-color: #EEF0F3;
  color: #4A5361;
  border: none;
  border-bottom: 1px solid #DDE1E6;
  height: 32px;
  padding: 0 8px;
}
QTableView, QTreeView, QListView {
  background-color: #FFFFFF;
  alternate-background-color: #F6F7F9;
  border: 1px solid #DDE1E6;
  border-radius: 8px;
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
  background-color: #E8EEFC;
  color: #1A1D23;
}

QToolTip {
  background-color: #1A1D23;
  color: #FFFFFF;
  border: none;
  padding: 4px 8px;
}

QProgressBar {
  background-color: #EEF0F3;
  border: none;
  border-radius: 9999px;
  height: 8px;
  text-align: center;
}
QProgressBar::chunk { background-color: #2563EB; border-radius: 9999px; }
