/* 생성 파일: design/tokens.json에서 만든다. 직접 고치지 말고 원본을 고친 뒤 scripts/gen_tokens.py (dark) */

QWidget {
  background-color: #0F1115;
  color: #E8EAEE;
  font-family: "Pretendard Variable", Pretendard, "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
  font-size: 14px;
}

QFrame#Surface, QGroupBox, QDialog {
  background-color: #171A20;
  border: 1px solid #2C313A;
  border-radius: 8px;
}

/* QGroupBox에 테두리를 입히면 Qt가 제목 자리를 비워 주지 않는다 — 여백과 ::title을 직접 정한다.
   없으면 제목이 첫 줄과 겹친다 (이슈 #3). */
QGroupBox {
  margin-top: 16px;
  padding: 12px 8px 8px 8px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 12px;
  padding: 0 4px;
  color: #B4BBC6;
  font-weight: 600;
}

/* QWidget 배경이 글자 위젯에도 칠해져 흰 상자 안에 회색 칸이 생긴다 — 글자는 놓인 곳의 배경을 따른다. */
QLabel, QCheckBox, QRadioButton { background-color: transparent; }

QLabel#Secondary { color: #B4BBC6; }
QLabel#Muted { color: #939CA9; }

QPushButton {
  background-color: #7AA2FF;
  color: #0F1115;
  border: none;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 12px;
  font-weight: 500;
}
QPushButton:hover { background-color: #9AB8FF; }
QPushButton:focus { border: 2px solid #7AA2FF; }
QPushButton:disabled { background-color: #20242C; color: #939CA9; }

QPushButton#Secondary {
  background-color: #171A20;
  color: #E8EAEE;
  border: 1px solid #3D444F;
}

QPushButton#Danger {
  background-color: #F2564A;
  color: #0F1115;
}

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QSpinBox {
  background-color: #171A20;
  color: #E8EAEE;
  border: 1px solid #3D444F;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 8px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
  border: 2px solid #7AA2FF;
}

/* QSpinBox에 테두리·둥근 모서리를 입히면 기본 ▲▼ 단추가 그 테두리 위에 그대로 겹쳐 잘린다 (이슈 #3, 150%).
   단추를 테두리 안쪽에 세로로 놓고, 칸 오른쪽에 그 자리를 비운다. */
QSpinBox { padding-right: 24px; }
QSpinBox::up-button, QSpinBox::down-button {
  subcontrol-origin: border;
  width: 20px;
  border: none;
  border-left: 1px solid #2C313A;
  background-color: transparent;
}
QSpinBox::up-button {
  subcontrol-position: top right;
  margin: 1px 1px 0 0;
  border-top-right-radius: 6px;
}
QSpinBox::down-button {
  subcontrol-position: bottom right;
  margin: 0 1px 1px 0;
  border-bottom-right-radius: 6px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #20242C; }
/* 단추를 꾸미면 Qt가 기본 화살표를 그리지 않는다 — 생성한 SVG를 쓴다. `@THEME_DIR@`는 테마를 읽을 때
   그 패키지 폴더의 실제 경로로 바뀐다 (chaeksas.qt.theme.qss). */
QSpinBox::up-arrow {
  image: url(@THEME_DIR@/arrow-up-dark.svg);
  width: 8px;
  height: 4px;
}
QSpinBox::down-arrow {
  image: url(@THEME_DIR@/arrow-down-dark.svg);
  width: 8px;
  height: 4px;
}

/* QCheckBox·QRadioButton에 **무엇이든** 스타일을 주면 Qt가 기본 표시기를 그리지 않는다 — 체크된 칸이
   상자 없이 ✓만 보였다 (이슈 #3). 표시기를 직접 그린다. ✓는 생성한 SVG다. */
QCheckBox::indicator, QRadioButton::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #3D444F;
  background-color: #171A20;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }  /* 지름의 절반 = 동그라미 */
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #7AA2FF; }
QCheckBox::indicator:checked {
  background-color: #7AA2FF;
  border-color: #7AA2FF;
  image: url(@THEME_DIR@/check-dark.svg);
}
QRadioButton::indicator:checked {
  background-color: #171A20;
  border: 4px solid #7AA2FF;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  background-color: #20242C;
  border-color: #2C313A;
}

QHeaderView::section {
  background-color: #20242C;
  color: #B4BBC6;
  border: none;
  border-bottom: 1px solid #2C313A;
  height: 32px;
  padding: 0 8px;
}
QTableView, QTreeView, QListView {
  background-color: #171A20;
  alternate-background-color: #0F1115;
  border: 1px solid #2C313A;
  border-radius: 8px;
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
  background-color: #1B2A4D;
  color: #E8EAEE;
}

QToolTip {
  background-color: #E8EAEE;
  color: #0F1115;
  border: none;
  padding: 4px 8px;
}

QProgressBar {
  background-color: #20242C;
  border: none;
  border-radius: 9999px;
  height: 8px;
  text-align: center;
}
QProgressBar::chunk { background-color: #5B8CFF; border-radius: 9999px; }
