<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx08_receivable_dunning" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:process id="Proc_bx08_receivable_dunning" name="매출채권 연체 독촉" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {
    "erp": "finance-ar"
  },
  "extensions": [
    {
      "id": "erp",
      "version": "&gt;=1,&lt;2"
    }
  ],
  "outputs": [],
  "inputs": []
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="매일 10:00">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 10 * * 1-5</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Overdue" name="연체 채권 조회">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "erp",
  "operation": "list_overdue_receivables",
  "input": {
    "기준일": "오늘"
  },
  "output": {
    "연체목록": "items"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Stage" name="단계 정하기">
      <bpmn:extensionElements>
        <chk:rule>{
  "decision": "dunning_stage",
  "input": {
    "연체일수": "채권.연체일수",
    "금액": "채권.금액"
  },
  "output": {
    "단계": "단계"
  }
}</chk:rule>
        <chk:loop>{
  "collection": "연체목록",
  "item": "채권",
  "result": "단계",
  "collect_into": "단계목록"
}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Task_Split" name="단계별 나누기" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:script>채권단계 = [dict(c, 단계=s) for c, s in zip(연체목록, 단계목록)]
안내대상 = [x for x in 채권단계 if x.단계 in ('1차', '2차')]
이관대상 = [x for x in 채권단계 if x.단계 == '이관검토']
이관건수 = len(이관대상)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Draft" name="독촉 메일 초안">
      <bpmn:extensionElements>
        <chk:aiTask>{
  "goal": "## 상황\n`대상`은 거래처 하나의 연체 정보다 (거래처명, 금액, 연체일수, 단계).\n\n## 할 일\n단계에 맞는 정중한 독촉 메일 제목과 본문을 쓴다. 1차는 안내, 2차는 기한을 명시한 독촉.\n\n## 판단하지 않는 것\n법적 조치를 언급하지 않는다. 금액·날짜를 바꾸지 않는다.\n\n## 반환\n- `메일`: {받는사람, 제목, 본문}",
  "domain": "llm",
  "results": {
    "메일": "dict"
  },
  "tools": [],
  "params": {}
}</chk:aiTask>
        <chk:loop>{
  "collection": "안내대상",
  "item": "대상",
  "result": "메일",
  "collect_into": "메일목록"
}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendBulk" name="독촉 메일 발송">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "erp",
  "operation": "send_customer_mail",
  "input": {
    "메일": "메일목록"
  },
  "output": {
    "발송결과": "result"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Escalate" name="이관 검토 있음?" default="Flow_08">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Approve_Legal" name="법무 이관 결재">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "연체 채권 법무 이관",
  "description": "",
  "show": [
    "이관대상"
  ],
  "fields": [
    {
      "key": "이관",
      "label": "법무로 넘깁니까?",
      "type": "bool",
      "required": true
    },
    {
      "key": "메모",
      "label": "메모",
      "type": "text",
      "required": false
    }
  ],
  "location": "center"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Transfer" name="이관?" default="Flow_11">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Transfer" name="법무 이관 등록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "erp",
  "operation": "mark_legal_transfer",
  "input": {
    "대상": "이관대상"
  },
  "output": {
    "등록결과": "result"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Overdue" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Overdue" targetRef="Task_Stage" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Stage" targetRef="Task_Split" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Split" targetRef="Task_Draft" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Draft" targetRef="Task_SendBulk" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SendBulk" targetRef="Gw_Escalate" />
    <bpmn:sequenceFlow id="Flow_07" name="있음" sourceRef="Gw_Escalate" targetRef="Approve_Legal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">len(이관대상) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" name="없음" sourceRef="Gw_Escalate" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Approve_Legal" targetRef="Gw_Transfer" />
    <bpmn:sequenceFlow id="Flow_10" name="이관" sourceRef="Gw_Transfer" targetRef="Task_Transfer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">이관</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" name="보류" sourceRef="Gw_Transfer" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Transfer" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx08_receivable_dunning">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Overdue_di" bpmnElement="Task_Overdue"><dc:Bounds x="266" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Stage_di" bpmnElement="Task_Stage"><dc:Bounds x="436" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Split_di" bpmnElement="Task_Split"><dc:Bounds x="606" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Draft_di" bpmnElement="Task_Draft"><dc:Bounds x="776" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendBulk_di" bpmnElement="Task_SendBulk"><dc:Bounds x="946" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Escalate_di" bpmnElement="Gw_Escalate" isMarkerVisible="true"><dc:Bounds x="1116" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1096" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Legal_di" bpmnElement="Approve_Legal"><dc:Bounds x="1236" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Transfer_di" bpmnElement="Gw_Transfer" isMarkerVisible="true"><dc:Bounds x="1406" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1386" y="299" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Transfer_di" bpmnElement="Task_Transfer"><dc:Bounds x="1526" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1696" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1676" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="120" /><di:waypoint x="436" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="536" y="120" /><di:waypoint x="606" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="706" y="120" /><di:waypoint x="776" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="876" y="120" /><di:waypoint x="946" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="1046" y="120" /><di:waypoint x="1116" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="1141" y="145" /><di:waypoint x="1141" y="270" /><di:waypoint x="1236" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="1145" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1166" y="120" /><di:waypoint x="1696" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="1170" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1336" y="270" /><di:waypoint x="1406" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1431" y="295" /><di:waypoint x="1431" y="420" /><di:waypoint x="1526" y="420" /><bpmndi:BPMNLabel><dc:Bounds x="1435" y="402" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1431" y="245" /><di:waypoint x="1431" y="120" /><di:waypoint x="1696" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="1435" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1626" y="420" /><di:waypoint x="1671" y="420" /><di:waypoint x="1671" y="120" /><di:waypoint x="1696" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
