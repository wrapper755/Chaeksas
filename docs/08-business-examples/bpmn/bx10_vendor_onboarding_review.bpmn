<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx10_vendor_onboarding_review" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:message id="Msg_vendor_registration" name="vendor_registration" />
  <bpmn:process id="Proc_bx10_vendor_onboarding_review" name="신규 거래처 등록 심사" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {
    "ext-credit": "purchase-credit",
    "compliance": "purchase-compliance",
    "erp": "purchase-erp"
  },
  "extensions": [
    {
      "id": "ext-credit",
      "version": "&gt;=1,&lt;2"
    },
    {
      "id": "compliance",
      "version": "&gt;=1,&lt;2"
    },
    {
      "id": "erp",
      "version": "&gt;=1,&lt;2"
    }
  ],
  "outputs": [],
  "inputs": [
    {
      "name": "신청번호",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "거래처명",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "사업자번호",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "해외",
      "type": "bool",
      "required": true,
      "description": ""
    },
    {
      "name": "예상거래액",
      "type": "int",
      "required": true,
      "description": "연간, 원"
    },
    {
      "name": "서류",
      "type": "list",
      "required": true,
      "description": "파일 경로 목록"
    },
    {
      "name": "회신주소",
      "type": "string",
      "required": true,
      "description": "포털 회신 웹훅"
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="등록 신청">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_vendor_registration" />
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="Gw_Checks" name="필요한 점검 고르기">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:serviceTask id="Task_Docs" name="서류 확인">
      <bpmn:extensionElements>
        <chk:aiTask>{
  "goal": "## 상황\n`서류`는 거래처가 올린 파일 목록이다.\n\n## 할 일\n사업자등록증과 통장 사본이 있는지, 사업자등록증의 번호·상호가 `사업자번호`·`거래처명`과 같은지 확인한다.\n\n## 판단하지 않는 것\n신용이나 거래 적합성은 판단하지 않는다.\n\n## 반환\n- `서류결과`: {충족(bool), 빠진서류(list), 불일치(list)}",
  "domain": "doc",
  "results": {
    "서류결과": "dict"
  },
  "tools": [
    "pdf_text_tool",
    "image_ocr_tool"
  ],
  "params": {}
}</chk:aiTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Credit" name="신용 점검">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "ext-credit",
  "operation": "lookup",
  "input": {
    "biz_no": "사업자번호"
  },
  "output": {
    "신용": "result"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Sanction" name="제재 목록 점검">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "compliance",
  "operation": "screen_sanctions",
  "input": {
    "name": "거래처명"
  },
  "output": {
    "제재": "hits"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:inclusiveGateway id="Gw_Join" name="점검 모으기">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:scriptTask id="Task_Summary" name="심사 요약" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:script>신용 = 신용 if 예상거래액 &gt;= 50000000 else None
제재 = 제재 if 해외 else []
권고 = '반려' if (not 서류결과.충족) or len(제재) &gt; 0 else '승인'
거래처코드 = ''</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Approve_Vendor" name="구매팀장 승인">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "신규 거래처 등록",
  "description": "",
  "show": [
    "거래처명",
    "사업자번호",
    "서류결과",
    "신용",
    "제재",
    "권고"
  ],
  "fields": [
    {
      "key": "결정",
      "label": "결정",
      "type": "choice",
      "required": true,
      "choices": [
        "승인",
        "반려",
        "보완요청"
      ]
    },
    {
      "key": "의견",
      "label": "의견",
      "type": "text",
      "required": false
    }
  ],
  "location": "center"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Decision" name="결정" default="Flow_12">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Register" name="ERP 거래처 등록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "erp",
  "operation": "create_vendor",
  "input": {
    "name": "거래처명",
    "biz_no": "사업자번호"
  },
  "output": {
    "거래처코드": "vendor_code"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Reply" name="포털에 결과 회신">
      <bpmn:extensionElements>
        <chk:webhook>{
  "url": "{회신주소}",
  "method": "POST",
  "body": "fields:[신청번호, 결정, 의견, 거래처코드]",
  "timeout_s": 10,
  "store_as": "회신결과"
}</chk:webhook>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Gw_Checks" />
    <bpmn:sequenceFlow id="Flow_02" name="항상" sourceRef="Gw_Checks" targetRef="Task_Docs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03" name="5천만 이상" sourceRef="Gw_Checks" targetRef="Task_Credit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">예상거래액 &gt;= 50000000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" name="해외" sourceRef="Gw_Checks" targetRef="Task_Sanction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">해외</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Docs" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Credit" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Sanction" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gw_Join" targetRef="Task_Summary" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Summary" targetRef="Approve_Vendor" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Approve_Vendor" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="Flow_11" name="승인" sourceRef="Gw_Decision" targetRef="Task_Register">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">결정 == '승인'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="반려·보완" sourceRef="Gw_Decision" targetRef="Task_Reply" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Register" targetRef="Task_Reply" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Reply" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx10_vendor_onboarding_review">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Checks_di" bpmnElement="Gw_Checks"><dc:Bounds x="266" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="246" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Docs_di" bpmnElement="Task_Docs"><dc:Bounds x="386" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Credit_di" bpmnElement="Task_Credit"><dc:Bounds x="386" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sanction_di" bpmnElement="Task_Sanction"><dc:Bounds x="386" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Join_di" bpmnElement="Gw_Join"><dc:Bounds x="556" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="536" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Summary_di" bpmnElement="Task_Summary"><dc:Bounds x="676" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Vendor_di" bpmnElement="Approve_Vendor"><dc:Bounds x="846" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Decision_di" bpmnElement="Gw_Decision" isMarkerVisible="true"><dc:Bounds x="1016" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="996" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register"><dc:Bounds x="1136" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reply_di" bpmnElement="Task_Reply"><dc:Bounds x="1306" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1476" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1456" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="316" y="120" /><di:waypoint x="386" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="320" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="291" y="145" /><di:waypoint x="291" y="270" /><di:waypoint x="386" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="295" y="252" width="72" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="291" y="145" /><di:waypoint x="291" y="420" /><di:waypoint x="386" y="420" /><bpmndi:BPMNLabel><dc:Bounds x="295" y="402" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="486" y="120" /><di:waypoint x="556" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="486" y="270" /><di:waypoint x="531" y="270" /><di:waypoint x="531" y="120" /><di:waypoint x="556" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="486" y="420" /><di:waypoint x="531" y="420" /><di:waypoint x="531" y="120" /><di:waypoint x="556" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="606" y="120" /><di:waypoint x="676" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="776" y="120" /><di:waypoint x="846" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="946" y="120" /><di:waypoint x="1016" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1041" y="145" /><di:waypoint x="1041" y="270" /><di:waypoint x="1136" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="1045" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1066" y="120" /><di:waypoint x="1306" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="1070" y="102" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1236" y="270" /><di:waypoint x="1281" y="270" /><di:waypoint x="1281" y="120" /><di:waypoint x="1306" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1406" y="120" /><di:waypoint x="1476" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
