<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx05_month_end_close" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:message id="Msg_close_purchase_done" name="close_purchase_done" />
  <bpmn:message id="Msg_close_sales_done" name="close_sales_done" />
  <bpmn:message id="Msg_close_stock_done" name="close_stock_done" />
  <bpmn:process id="Proc_bx05_month_end_close" name="월말 마감 체크리스트" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {},
  "extensions": [],
  "outputs": [],
  "inputs": [
    {
      "name": "마감월",
      "type": "string",
      "required": false,
      "description": "`YYYY-MM`. 비우면 이번 달"
    },
    {
      "name": "영업담당",
      "type": "string",
      "required": false,
      "description": "독촉 받는 사람",
      "default": "sales@example.com"
    },
    {
      "name": "재무팀메일",
      "type": "string",
      "required": false,
      "description": "",
      "default": "finance@example.com"
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="말일 18:00">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">0 18 L * *</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Init" name="마감월 정하기" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:script>마감월 = 마감월 or 이번달()</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:intermediateThrowEvent id="Ms_Open" name="마감 시작">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="Gw_Split" name="세 부서 기다리기">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:receiveTask id="Recv_Sales" name="매출 확정 받기" messageRef="Msg_close_sales_done">
      <bpmn:extensionElements>
        <chk:receive>{
  "correlation": "마감월",
  "payload": [
    "매출확정"
  ]
}</chk:receive>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Recv_Purchase" name="매입 확정 받기" messageRef="Msg_close_purchase_done">
      <bpmn:extensionElements>
        <chk:receive>{
  "correlation": "마감월",
  "payload": [
    "매입확정"
  ]
}</chk:receive>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Recv_Stock" name="재고 실사 받기" messageRef="Msg_close_stock_done">
      <bpmn:extensionElements>
        <chk:receive>{
  "correlation": "마감월",
  "payload": [
    "재고실사"
  ]
}</chk:receive>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Task_RemindSales" name="영업 독촉">
      <bpmn:extensionElements>
        <chk:email>{
  "to": [
    "{영업담당}"
  ],
  "subject": "[{마감월}] 매출 확정 통보를 기다립니다",
  "body": "오늘 안에 확정해 주세요.",
  "attachments": [],
  "store_as": null
}</chk:email>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_RemindSales" name="독촉 끝">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gw_Join" name="모두 도착">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="Ms_AllIn" name="통보 완료">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:serviceTask id="Task_Journal" name="결산 분개 초안">
      <bpmn:extensionElements>
        <chk:aiTask>{
  "goal": "## 상황\n`매출확정`, `매입확정`, `재고실사`는 각 부서가 보낸 확정 자료(JSON)다.\n\n## 할 일\n계정과목표(업무 파라미터 `계정과목`)에 맞춰 결산 분개 초안을 만든다.\n\n## 판단하지 않는 것\n금액을 고치거나 누락분을 추정하지 않는다. 맞지 않으면 `불일치`에 적는다.\n\n## 반환\n- `분개초안`: list of {계정, 차변, 대변, 적요}\n- `불일치`: list of string",
  "domain": "llm",
  "results": {
    "분개초안": "list",
    "불일치": "list"
  },
  "tools": [],
  "params": {
    "계정과목": [
      "매출",
      "매출원가",
      "외상매출금",
      "외상매입금",
      "상품"
    ]
  }
}</chk:aiTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Approve_Close" name="마감 승인">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "월말 마감 승인",
  "description": "",
  "show": [
    "마감월",
    "분개초안",
    "불일치"
  ],
  "fields": [
    {
      "key": "승인",
      "label": "마감합니까?",
      "type": "bool",
      "required": true
    },
    {
      "key": "메모",
      "label": "메모",
      "type": "text",
      "required": false
    }
  ],
  "location": "center"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Data_Journal">
        <bpmn:targetRef>Data_Journal</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Close" name="마감?" default="Flow_17">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Ms_Closed" name="마감 완료">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_Hold" name="마감 보류 알림">
      <bpmn:extensionElements>
        <chk:email>{
  "to": [
    "{재무팀메일}"
  ],
  "subject": "[{마감월}] 월말 마감 보류",
  "body": "{메모}",
  "attachments": [],
  "store_as": null
}</chk:email>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Hold" name="보류">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Bnd_SalesLate" name="하루 지남" attachedToRef="Recv_Sales" cancelActivity="false">
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Init" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Init" targetRef="Ms_Open" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Ms_Open" targetRef="Gw_Split" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gw_Split" targetRef="Recv_Sales" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gw_Split" targetRef="Recv_Purchase" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gw_Split" targetRef="Recv_Stock" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Recv_Sales" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Recv_Purchase" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Recv_Stock" targetRef="Gw_Join" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Bnd_SalesLate" targetRef="Task_RemindSales" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RemindSales" targetRef="End_RemindSales" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gw_Join" targetRef="Ms_AllIn" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Ms_AllIn" targetRef="Task_Journal" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Journal" targetRef="Approve_Close" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Approve_Close" targetRef="Gw_Close" />
    <bpmn:sequenceFlow id="Flow_16" name="마감" sourceRef="Gw_Close" targetRef="Ms_Closed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">승인</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" name="보류" sourceRef="Gw_Close" targetRef="Task_Hold" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Ms_Closed" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Hold" targetRef="End_Hold" />
    <bpmn:dataObject id="DO_Data_Journal" />
    <bpmn:dataObjectReference id="Data_Journal" name="결산 분개" dataObjectRef="DO_Data_Journal">
      <bpmn:extensionElements>
        <chk:dataOutput>{
  "path": "마감/{마감월}_분개.json",
  "format": "json",
  "store_as": "분개경로",
  "variables": [
    "분개초안",
    "불일치",
    "승인",
    "메모"
  ]
}</chk:dataOutput>
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx05_month_end_close">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Init_di" bpmnElement="Task_Init"><dc:Bounds x="266" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ms_Open_di" bpmnElement="Ms_Open"><dc:Bounds x="436" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="416" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Split_di" bpmnElement="Gw_Split"><dc:Bounds x="542" y="135" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="522" y="189" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recv_Sales_di" bpmnElement="Recv_Sales"><dc:Bounds x="662" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recv_Purchase_di" bpmnElement="Recv_Purchase"><dc:Bounds x="662" y="270" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recv_Stock_di" bpmnElement="Recv_Stock"><dc:Bounds x="662" y="420" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RemindSales_di" bpmnElement="Task_RemindSales"><dc:Bounds x="832" y="570" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RemindSales_di" bpmnElement="End_RemindSales"><dc:Bounds x="1002" y="592" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="982" y="632" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Join_di" bpmnElement="Gw_Join"><dc:Bounds x="857" y="135" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="837" y="189" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ms_AllIn_di" bpmnElement="Ms_AllIn"><dc:Bounds x="1002" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="982" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Journal_di" bpmnElement="Task_Journal"><dc:Bounds x="1108" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Close_di" bpmnElement="Approve_Close"><dc:Bounds x="1278" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Close_di" bpmnElement="Gw_Close" isMarkerVisible="true"><dc:Bounds x="1448" y="135" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1428" y="189" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ms_Closed_di" bpmnElement="Ms_Closed"><dc:Bounds x="1600" y="292" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1580" y="332" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1738" y="292" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1718" y="332" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Hold_di" bpmnElement="Task_Hold"><dc:Bounds x="1568" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Hold_di" bpmnElement="End_Hold"><dc:Bounds x="1738" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1718" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_SalesLate_di" bpmnElement="Bnd_SalesLate"><dc:Bounds x="722" y="182" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="718" y="220" width="44" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Journal_di" bpmnElement="Data_Journal"><dc:Bounds x="1310" y="20" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1352" y="36" width="70" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="160" /><di:waypoint x="266" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="160" /><di:waypoint x="436" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="472" y="160" /><di:waypoint x="542" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="592" y="160" /><di:waypoint x="662" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="567" y="185" /><di:waypoint x="567" y="310" /><di:waypoint x="662" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="567" y="185" /><di:waypoint x="567" y="460" /><di:waypoint x="662" y="460" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="762" y="160" /><di:waypoint x="857" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="762" y="310" /><di:waypoint x="832" y="310" /><di:waypoint x="832" y="160" /><di:waypoint x="857" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="762" y="460" /><di:waypoint x="832" y="460" /><di:waypoint x="832" y="160" /><di:waypoint x="857" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="740" y="218" /><di:waypoint x="740" y="230" /><di:waypoint x="787" y="230" /><di:waypoint x="787" y="610" /><di:waypoint x="832" y="610" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="932" y="610" /><di:waypoint x="1002" y="610" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="907" y="160" /><di:waypoint x="1002" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1038" y="160" /><di:waypoint x="1108" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1208" y="160" /><di:waypoint x="1278" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="1378" y="160" /><di:waypoint x="1448" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="1473" y="185" /><di:waypoint x="1473" y="310" /><di:waypoint x="1600" y="310" /><bpmndi:BPMNLabel><dc:Bounds x="1477" y="292" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17"><di:waypoint x="1498" y="160" /><di:waypoint x="1568" y="160" /><bpmndi:BPMNLabel><dc:Bounds x="1502" y="142" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18"><di:waypoint x="1636" y="310" /><di:waypoint x="1738" y="310" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19"><di:waypoint x="1668" y="160" /><di:waypoint x="1738" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Data_Journal_di" bpmnElement="DOA_Data_Journal"><di:waypoint x="1328" y="120" /><di:waypoint x="1328" y="70" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
