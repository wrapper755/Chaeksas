<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_fx16_web_review_field" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:process id="Proc_fx16_web_review_field" name="현장 확인 (PC 결재 위치)" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "pc",
  "service_keys": {
    "ui-automation": "test-ui"
  },
  "extensions": [
    {
      "id": "ui-automation",
      "version": "&gt;=0.1,&lt;0.2"
    }
  ],
  "outputs": [],
  "inputs": []
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="시작">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Collect" name="정보 모으기">
      <bpmn:extensionElements>
        <chk:task type="ui_task" extension="ui-automation">{
  "page_id": "intranet.notice.list",
  "steps": [
    {
      "key": "notice.table",
      "action": "read_table",
      "result": "공지"
    }
  ],
  "heal": true
}</chk:task>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Approve_Review" name="현장 확인">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "수집 결과 확인",
  "description": "",
  "show": [
    "공지"
  ],
  "fields": [
    {
      "key": "승인",
      "label": "다음 단계로",
      "type": "bool",
      "required": true
    }
  ],
  "location": "field"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Ok" name="승인?" default="Flow_05">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Follow" name="첫 링크 열기">
      <bpmn:extensionElements>
        <chk:task type="ui_task" extension="ui-automation">{
  "page_id": "intranet.notice.list",
  "steps": [
    {
      "key": "notice.first_link",
      "action": "click"
    }
  ],
  "heal": true
}</chk:task>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_Skip" name="건너뜀" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:script>메모 = '사용자 보류'</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Collect" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Collect" targetRef="Approve_Review" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Approve_Review" targetRef="Gw_Ok" />
    <bpmn:sequenceFlow id="Flow_04" name="예" sourceRef="Gw_Ok" targetRef="Task_Follow">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">승인</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="아니오" sourceRef="Gw_Ok" targetRef="Task_Skip" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Follow" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Skip" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_fx16_web_review_field">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Collect_di" bpmnElement="Task_Collect"><dc:Bounds x="266" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Review_di" bpmnElement="Approve_Review"><dc:Bounds x="436" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Ok_di" bpmnElement="Gw_Ok" isMarkerVisible="true"><dc:Bounds x="606" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="586" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Follow_di" bpmnElement="Task_Follow"><dc:Bounds x="726" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Skip_di" bpmnElement="Task_Skip"><dc:Bounds x="726" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="896" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="876" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="120" /><di:waypoint x="436" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="536" y="120" /><di:waypoint x="606" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="631" y="145" /><di:waypoint x="631" y="270" /><di:waypoint x="726" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="635" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="656" y="120" /><di:waypoint x="726" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="660" y="102" width="36" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="826" y="270" /><di:waypoint x="871" y="270" /><di:waypoint x="871" y="120" /><di:waypoint x="896" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="826" y="120" /><di:waypoint x="896" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
