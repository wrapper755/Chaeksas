<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_fx14_timers" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:process id="Proc_fx14_timers" name="중간 타이머와 결재 시간 제한" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {},
  "extensions": [],
  "outputs": [],
  "inputs": []
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="시작">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Wait" name="3초 대기">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Approve_Review" name="15초 결재">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "빠른 결재",
  "description": "",
  "show": [
    "오늘"
  ],
  "fields": [
    {
      "key": "승인",
      "label": "승인",
      "type": "bool",
      "required": true
    }
  ],
  "location": "center"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Task_Answered" name="응답" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:script>결과 = '응답'</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Timeout" name="보류" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:script>결과 = '보류'</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Bnd_Timeout" name="15초" attachedToRef="Approve_Review">
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Wait" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Wait" targetRef="Approve_Review" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Approve_Review" targetRef="Task_Answered" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Bnd_Timeout" targetRef="Task_Timeout" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Answered" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Timeout" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_fx14_timers">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Wait_di" bpmnElement="Wait"><dc:Bounds x="266" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="246" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Review_di" bpmnElement="Approve_Review"><dc:Bounds x="372" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Answered_di" bpmnElement="Task_Answered"><dc:Bounds x="542" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Timeout_di" bpmnElement="Task_Timeout"><dc:Bounds x="542" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="712" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="692" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_Timeout_di" bpmnElement="Bnd_Timeout"><dc:Bounds x="432" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="428" y="180" width="44" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="302" y="120" /><di:waypoint x="372" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="472" y="120" /><di:waypoint x="542" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="450" y="178" /><di:waypoint x="450" y="270" /><di:waypoint x="542" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="642" y="120" /><di:waypoint x="712" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="642" y="270" /><di:waypoint x="687" y="270" /><di:waypoint x="687" y="120" /><di:waypoint x="712" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
