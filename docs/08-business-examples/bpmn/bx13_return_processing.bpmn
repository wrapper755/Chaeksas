<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx13_return_processing" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:message id="Msg_return_arrived" name="return_arrived" />
  <bpmn:message id="Msg_return_request" name="return_request" />
  <bpmn:process id="Proc_bx13_return_processing" name="반품 처리" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {
    "shop": "sales-shop"
  },
  "extensions": [
    {
      "id": "shop",
      "version": "&gt;=1,&lt;2"
    }
  ],
  "outputs": [],
  "inputs": [
    {
      "name": "반품번호",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "주문번호",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "사유",
      "type": "string",
      "required": true,
      "description": "고객이 쓴 글"
    },
    {
      "name": "금액",
      "type": "int",
      "required": true,
      "description": ""
    },
    {
      "name": "고객메일",
      "type": "string",
      "required": true,
      "description": ""
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="반품 신청">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_return_request" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Classify" name="사유 분류">
      <bpmn:extensionElements>
        <chk:aiTask>{
  "goal": "## 상황\n`사유`는 고객이 직접 쓴 반품 사유다.\n\n## 할 일\n단순변심 / 불량 / 오배송 중 하나로 분류하고 근거를 한 줄로 적는다.\n\n## 판단하지 않는 것\n환불 여부나 금액을 판단하지 않는다.\n\n## 반환\n- `분류`: string (단순변심|불량|오배송)\n- `근거`: string",
  "domain": "llm",
  "results": {
    "분류": "string",
    "근거": "string"
  },
  "tools": [],
  "params": {}
}</chk:aiTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Recv_Arrived" name="입고 대기" messageRef="Msg_return_arrived">
      <bpmn:extensionElements>
        <chk:receive>{
  "correlation": "반품번호",
  "payload": [
    "검수통과",
    "검수메모"
  ]
}</chk:receive>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gw_Inspect" name="검수 결과" default="Flow_05">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Refund" name="환불">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "shop",
  "operation": "refund",
  "input": {
    "order_id": "주문번호",
    "amount": "환불액"
  },
  "output": {
    "환불결과": "result"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Reject" name="반품 불가 안내">
      <bpmn:extensionElements>
        <chk:email>{
  "to": [
    "{고객메일}"
  ],
  "subject": "[{주문번호}] 반품 불가 안내",
  "body": "검수 결과: {검수메모}",
  "attachments": [],
  "store_as": null
}</chk:email>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_Cancelled" name="자동 취소 안내">
      <bpmn:extensionElements>
        <chk:email>{
  "to": [
    "{고객메일}"
  ],
  "subject": "[{주문번호}] 반품 신청 취소",
  "body": "14일 안에 상품이 도착하지 않아 신청이 취소되었습니다.",
  "attachments": [],
  "store_as": null
}</chk:email>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:scriptTask id="Task_Amount" name="환불액 계산" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:script>환불액 = 금액 - (0 if 분류 in ('불량', '오배송') else 3000)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Bnd_Timeout" name="14일" attachedToRef="Recv_Arrived">
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Classify" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Classify" targetRef="Recv_Arrived" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Recv_Arrived" targetRef="Gw_Inspect" />
    <bpmn:sequenceFlow id="Flow_04" name="통과" sourceRef="Gw_Inspect" targetRef="Task_Amount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">검수통과</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="불가" sourceRef="Gw_Inspect" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_Amount" targetRef="Task_Refund" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Refund" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Reject" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Bnd_Timeout" targetRef="Task_Cancelled" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Cancelled" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx13_return_processing">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Classify_di" bpmnElement="Task_Classify"><dc:Bounds x="266" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recv_Arrived_di" bpmnElement="Recv_Arrived"><dc:Bounds x="436" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Inspect_di" bpmnElement="Gw_Inspect" isMarkerVisible="true"><dc:Bounds x="631" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="611" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Refund_di" bpmnElement="Task_Refund"><dc:Bounds x="946" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject"><dc:Bounds x="776" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cancelled_di" bpmnElement="Task_Cancelled"><dc:Bounds x="606" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Amount_di" bpmnElement="Task_Amount"><dc:Bounds x="776" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1116" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1096" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_Timeout_di" bpmnElement="Bnd_Timeout"><dc:Bounds x="496" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="492" y="180" width="44" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="120" /><di:waypoint x="436" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="536" y="120" /><di:waypoint x="631" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="681" y="120" /><di:waypoint x="706" y="120" /><di:waypoint x="706" y="270" /><di:waypoint x="776" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="710" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="681" y="120" /><di:waypoint x="776" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="685" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="876" y="270" /><di:waypoint x="946" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="1046" y="270" /><di:waypoint x="1091" y="270" /><di:waypoint x="1091" y="120" /><di:waypoint x="1116" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="876" y="120" /><di:waypoint x="1116" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="514" y="178" /><di:waypoint x="514" y="270" /><di:waypoint x="606" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="706" y="270" /><di:waypoint x="1091" y="270" /><di:waypoint x="1091" y="120" /><di:waypoint x="1116" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
