<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Defs_card_policy" name="법인카드 사용 정책" namespace="urn:chaeksas:examples">
  <dmn:decision id="card_policy" name="법인카드 사용 정책">
    <dmn:decisionTable id="DT_card_policy" hitPolicy="COLLECT">
      <dmn:input id="In_0" label="요일">
        <dmn:inputExpression id="InE_0" typeRef="string"><dmn:text>요일</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:input id="In_1" label="시각">
        <dmn:inputExpression id="InE_1" typeRef="number"><dmn:text>시</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:input id="In_2" label="업종">
        <dmn:inputExpression id="InE_2" typeRef="string"><dmn:text>업종</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:input id="In_3" label="금액">
        <dmn:inputExpression id="InE_3" typeRef="number"><dmn:text>금액</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:output id="Out_0" name="violation" typeRef="string" />
      <dmn:rule id="Rule_0">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R0_I0"><dmn:text>"토","일"</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R0_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R0_I2"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R0_I3"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R0_O0"><dmn:text>"주말 사용"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_1">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R1_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R1_I1"><dmn:text>&gt;= 23</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R1_I2"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R1_I3"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R1_O0"><dmn:text>"심야 사용"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_2">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R2_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R2_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R2_I2"><dmn:text>"유흥","골프"</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R2_I3"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R2_O0"><dmn:text>"제한 업종"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_3">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R3_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R3_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R3_I2"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R3_I3"><dmn:text>&gt; 500000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R3_O0"><dmn:text>"1회 한도 초과"</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
