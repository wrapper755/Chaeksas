<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_fx24_batch_intake" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:error id="Err_DELEGATION_FAILED" name="DELEGATION_FAILED" errorCode="DELEGATION_FAILED" />
  <bpmn:process id="Proc_fx24_batch_intake" name="일괄 기동 — 접수 Bot" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {},
  "extensions": [],
  "outputs": [],
  "inputs": [
    {
      "name": "인입",
      "type": "list",
      "required": true,
      "description": "{번호, 금액} 목록"
    },
    {
      "name": "감독자",
      "type": "list",
      "required": true,
      "description": "이 일괄을 승인할 사람들 — Center가 가상 직원 등록에서 넣는다",
      "source": "virtual_worker.supervisors"
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="시작">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Count" name="건수 세기" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:script>건수 = len(인입)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:userTask id="Approve_Batch" name="일괄 승인">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "인입 {건수}건 일괄 기동",
  "description": "",
  "show": [
    "인입",
    "건수"
  ],
  "fields": [
    {
      "key": "승인",
      "label": "모두 기동합니까?",
      "type": "bool",
      "required": true
    },
    {
      "key": "메모",
      "label": "메모",
      "type": "text",
      "required": false
    }
  ],
  "location": "center",
  "assignees": "감독자"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Ok" name="승인?" default="Flow_05">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_Batch" name="건마다 기동 (위임 반복)" calledElement="Proc_fx25_batch_item">
      <bpmn:extensionElements>
        <chk:call>{
  "delegate": {
    "bpm_process_id": "fx25-batch-item"
  },
  "input": {
    "번호": "건['번호']",
    "금액": "건['금액']"
  },
  "output": {
    "처리결과": "처리결과"
  }
}</chk:call>
        <chk:loop>{
  "collection": "인입",
  "item": "건",
  "result": "처리결과",
  "collect_into": "결과목록"
}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:callActivity>
    <bpmn:scriptTask id="Task_Tally" name="결과 세기" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:script>등록수 = len([x for x in 결과목록 if x == '등록'])
보류수 = len(결과목록) - 등록수</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Failed" name="기동 실패" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:script>실패사유 = error_message</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Bnd_Batch" name="기동 실패" attachedToRef="Call_Batch">
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Err_DELEGATION_FAILED" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Count" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Count" targetRef="Approve_Batch" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Approve_Batch" targetRef="Gw_Ok" />
    <bpmn:sequenceFlow id="Flow_04" name="기동" sourceRef="Gw_Ok" targetRef="Call_Batch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">승인</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" name="반려" sourceRef="Gw_Ok" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Call_Batch" targetRef="Task_Tally" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Tally" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Bnd_Batch" targetRef="Task_Failed" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Failed" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_fx24_batch_intake">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Count_di" bpmnElement="Task_Count"><dc:Bounds x="266" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Batch_di" bpmnElement="Approve_Batch"><dc:Bounds x="436" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Ok_di" bpmnElement="Gw_Ok" isMarkerVisible="true"><dc:Bounds x="606" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="586" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Batch_di" bpmnElement="Call_Batch"><dc:Bounds x="726" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Tally_di" bpmnElement="Task_Tally"><dc:Bounds x="896" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Failed_di" bpmnElement="Task_Failed"><dc:Bounds x="896" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1066" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1046" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_Batch_di" bpmnElement="Bnd_Batch"><dc:Bounds x="786" y="292" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="782" y="330" width="44" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="120" /><di:waypoint x="436" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="536" y="120" /><di:waypoint x="606" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="631" y="145" /><di:waypoint x="631" y="270" /><di:waypoint x="726" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="635" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="656" y="120" /><di:waypoint x="1066" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="660" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="826" y="270" /><di:waypoint x="896" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="996" y="270" /><di:waypoint x="1041" y="270" /><di:waypoint x="1041" y="120" /><di:waypoint x="1066" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="804" y="328" /><di:waypoint x="804" y="420" /><di:waypoint x="896" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="996" y="420" /><di:waypoint x="1041" y="420" /><di:waypoint x="1041" y="120" /><di:waypoint x="1066" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
