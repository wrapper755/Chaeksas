<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx17_erp_po_entry" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:process id="Proc_bx17_erp_po_entry" name="ERP 발주 화면 입력" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "pc",
  "service_keys": {
    "ui-automation": "purchase-erp-ui"
  },
  "extensions": [
    {
      "id": "ui-automation",
      "version": "&gt;=0.4,&lt;0.5"
    }
  ],
  "outputs": [],
  "inputs": [
    {
      "name": "발주",
      "type": "list",
      "required": true,
      "description": "{품목, 수량}"
    }
  ]
}</chk:process>
      <chk:defaults>{
  "confirm_triggers": [
    "재고 부족 경고 창"
  ],
  "forbidden_actions": [
    "삭제 버튼을 누르지 않는다"
  ],
  "desktop": {
    "app": "ERP Client"
  }
}</chk:defaults>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="작업 지시">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Entry" name="발주 입력">
      <bpmn:extensionElements>
        <chk:task type="ui_task" extension="ui-automation">{
  "page_id": "erp.desktop.po_entry",
  "steps": [
    {
      "key": "po.item",
      "action": "fill",
      "value": "{건.품목}"
    },
    {
      "key": "po.qty",
      "action": "fill",
      "value": "{건.수량}"
    },
    {
      "key": "po.save",
      "action": "click"
    },
    {
      "key": "po.number",
      "action": "read",
      "result": "발주번호"
    }
  ],
  "heal": true
}</chk:task>
        <chk:loop>{
  "collection": "발주",
  "item": "건",
  "result": "발주번호",
  "collect_into": "발주번호목록"
}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Entry" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Entry" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx17_erp_po_entry">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Entry_di" bpmnElement="Task_Entry"><dc:Bounds x="266" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="436" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="416" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="120" /><di:waypoint x="436" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
