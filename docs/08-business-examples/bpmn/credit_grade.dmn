<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Defs_credit_grade" name="신용 등급 분류" namespace="urn:chaeksas:examples">
  <dmn:decision id="credit_grade" name="신용 등급 분류">
    <dmn:decisionTable id="DT_credit_grade" hitPolicy="FIRST">
      <dmn:input id="In_0" label="신용점수">
        <dmn:inputExpression id="InE_0" typeRef="number"><dmn:text>score</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:input id="In_1" label="연체">
        <dmn:inputExpression id="InE_1" typeRef="boolean"><dmn:text>overdue</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:output id="Out_0" name="grade" typeRef="string" />
      <dmn:rule id="Rule_0">
        <dmn:description>연체가 있으면 점수와 무관하게 위험</dmn:description>
        <dmn:inputEntry id="R0_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R0_I1"><dmn:text>true</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R0_O0"><dmn:text>"위험"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_1">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R1_I0"><dmn:text>&lt; 600</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R1_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R1_O0"><dmn:text>"위험"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_2">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R2_I0"><dmn:text>[600..750)</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R2_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R2_O0"><dmn:text>"주의"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_3">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R3_I0"><dmn:text>&gt;= 750</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R3_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R3_O0"><dmn:text>"정상"</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
