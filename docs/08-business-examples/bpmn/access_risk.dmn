<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Defs_access_risk" name="권한 위험도" namespace="urn:chaeksas:examples">
  <dmn:decision id="access_risk" name="권한 위험도">
    <dmn:decisionTable id="DT_access_risk" hitPolicy="FIRST">
      <dmn:input id="In_0" label="시스템">
        <dmn:inputExpression id="InE_0" typeRef="string"><dmn:text>시스템</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:input id="In_1" label="권한">
        <dmn:inputExpression id="InE_1" typeRef="string"><dmn:text>권한</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:output id="Out_0" name="risk" typeRef="string" />
      <dmn:rule id="Rule_0">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R0_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R0_I1"><dmn:text>"admin"</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R0_O0"><dmn:text>"높음"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_1">
        <dmn:description>재무·인사 쓰기</dmn:description>
        <dmn:inputEntry id="R1_I0"><dmn:text>"ERP","HRIS"</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R1_I1"><dmn:text>"write"</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R1_O0"><dmn:text>"높음"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_2">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R2_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R2_I1"><dmn:text>"write"</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R2_O0"><dmn:text>"중간"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_3">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R3_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R3_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R3_O0"><dmn:text>"낮음"</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
