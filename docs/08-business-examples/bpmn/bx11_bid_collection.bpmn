<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx11_bid_collection" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:message id="Msg_bid_cancelled" name="bid_cancelled" />
  <bpmn:message id="Msg_bid_quote" name="bid_quote" />
  <bpmn:process id="Proc_bx11_bid_collection" name="입찰 접수와 마감" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {},
  "extensions": [],
  "outputs": [],
  "inputs": [
    {
      "name": "입찰번호",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "마감시각",
      "type": "string",
      "required": true,
      "description": "ISO 8601 시각 (예 `2026-10-15T18:00:00+09:00`)"
    },
    {
      "name": "품목",
      "type": "list",
      "required": true,
      "description": ""
    },
    {
      "name": "견적목록",
      "type": "list",
      "required": false,
      "description": "받은 견적 (루프가 쌓는다)",
      "default": []
    },
    {
      "name": "응찰사메일",
      "type": "list",
      "required": false,
      "description": "응찰사 회신 주소 (루프가 쌓는다)",
      "default": []
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="공고 발행">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:receiveTask id="Recv_Quote" name="견적 받기" messageRef="Msg_bid_quote">
      <bpmn:extensionElements>
        <chk:receive>{
  "correlation": "입찰번호",
  "payload": [
    "견적"
  ]
}</chk:receive>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:scriptTask id="Task_Record" name="견적 기록" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:script>견적목록 = 견적목록 + [견적]
응찰사메일 = 응찰사메일 + [견적.회신메일]
응찰수 = len(견적목록)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Close" name="접수 마감" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:script>응찰수 = len(견적목록)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gw_Any" name="응찰 있음?" default="Flow_07">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Compare" name="견적 비교표">
      <bpmn:extensionElements>
        <chk:aiTask>{
  "goal": "## 상황\n`견적목록`은 공급사별 견적이다 (단가, 납기, 조건). `품목`은 공고 품목이다.\n\n## 할 일\n품목별로 견적을 비교하는 표를 만들고, 가격·납기·조건의 장단점을 한 줄씩 적는다.\n\n## 판단하지 않는 것\n낙찰사를 정하지 않는다. 견적에 없는 값을 추정하지 않는다.\n\n## 반환\n- `비교표`: markdown 표 문자열\n- `요약`: string",
  "domain": "llm",
  "results": {
    "비교표": "string",
    "요약": "string"
  },
  "tools": [],
  "params": {}
}</chk:aiTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Data_Compare">
        <bpmn:targetRef>Data_Compare</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Approve_Award" name="낙찰사 선택">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "낙찰사 선택",
  "description": "",
  "show": [
    "입찰번호",
    "비교표",
    "요약"
  ],
  "fields": [
    {
      "key": "낙찰사",
      "label": "낙찰사",
      "type": "text",
      "required": true
    },
    {
      "key": "사유",
      "label": "선정 사유",
      "type": "text",
      "required": true
    }
  ],
  "location": "center"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_NotifyAward" name="결과 통보">
      <bpmn:extensionElements>
        <chk:email>{
  "to": [
    "{응찰사메일}"
  ],
  "subject": "[{입찰번호}] 입찰 결과",
  "body": "낙찰사: {낙찰사}",
  "attachments": [],
  "store_as": null
}</chk:email>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_NoBid" name="유찰">
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_NotifyCancel" name="취소 통보">
      <bpmn:extensionElements>
        <chk:email>{
  "to": [
    "{응찰사메일}"
  ],
  "subject": "[{입찰번호}] 입찰 취소",
  "body": "공고가 취소되었습니다.",
  "attachments": [],
  "store_as": null
}</chk:email>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Cancel" name="취소로 끝">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Bnd_Deadline" name="마감" attachedToRef="Recv_Quote">
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">마감시각</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Bnd_Cancel" name="입찰 취소" attachedToRef="Recv_Quote">
      <bpmn:extensionElements>
        <chk:receive>{
  "correlation": "입찰번호"
}</chk:receive>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_bid_cancelled" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Recv_Quote" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Recv_Quote" targetRef="Task_Record" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Record" targetRef="Recv_Quote" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Bnd_Deadline" targetRef="Task_Close" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Close" targetRef="Gw_Any" />
    <bpmn:sequenceFlow id="Flow_06" name="있음" sourceRef="Gw_Any" targetRef="Task_Compare">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">응찰수 &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" name="없음" sourceRef="Gw_Any" targetRef="End_NoBid" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_Compare" targetRef="Approve_Award" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Approve_Award" targetRef="Task_NotifyAward" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_NotifyAward" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Bnd_Cancel" targetRef="Task_NotifyCancel" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_NotifyCancel" targetRef="End_Cancel" />
    <bpmn:dataObject id="DO_Data_Compare" />
    <bpmn:dataObjectReference id="Data_Compare" name="비교표" dataObjectRef="DO_Data_Compare">
      <bpmn:extensionElements>
        <chk:dataOutput>{
  "path": "입찰/{입찰번호}_비교.md",
  "format": "md",
  "store_as": "비교표경로",
  "template": "# {입찰번호} 견적 비교\n\n{비교표}\n\n{요약}"
}</chk:dataOutput>
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx11_bid_collection">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Recv_Quote_di" bpmnElement="Recv_Quote"><dc:Bounds x="266" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Record_di" bpmnElement="Task_Record"><dc:Bounds x="436" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Close_di" bpmnElement="Task_Close"><dc:Bounds x="436" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Any_di" bpmnElement="Gw_Any" isMarkerVisible="true"><dc:Bounds x="606" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="586" y="299" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Compare_di" bpmnElement="Task_Compare"><dc:Bounds x="726" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Award_di" bpmnElement="Approve_Award"><dc:Bounds x="896" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyAward_di" bpmnElement="Task_NotifyAward"><dc:Bounds x="1066" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1236" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1216" y="442" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoBid_di" bpmnElement="End_NoBid"><dc:Bounds x="758" y="252" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="738" y="292" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyCancel_di" bpmnElement="Task_NotifyCancel"><dc:Bounds x="436" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cancel_di" bpmnElement="End_Cancel"><dc:Bounds x="613" y="402" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="593" y="442" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_Deadline_di" bpmnElement="Bnd_Deadline"><dc:Bounds x="326" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="322" y="180" width="44" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bnd_Cancel_di" bpmnElement="Bnd_Cancel"><dc:Bounds x="281" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="277" y="180" width="44" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Compare_di" bpmnElement="Data_Compare"><dc:Bounds x="758" y="510" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="800" y="526" width="46" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="120" /><di:waypoint x="436" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="486" y="80" /><di:waypoint x="486" y="55" /><di:waypoint x="316" y="55" /><di:waypoint x="316" y="80" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="344" y="178" /><di:waypoint x="344" y="270" /><di:waypoint x="436" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="536" y="270" /><di:waypoint x="606" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="656" y="270" /><di:waypoint x="681" y="270" /><di:waypoint x="681" y="420" /><di:waypoint x="726" y="420" /><bpmndi:BPMNLabel><dc:Bounds x="685" y="402" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="656" y="270" /><di:waypoint x="758" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="660" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="826" y="420" /><di:waypoint x="896" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="996" y="420" /><di:waypoint x="1066" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1166" y="420" /><di:waypoint x="1236" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="299" y="178" /><di:waypoint x="299" y="420" /><di:waypoint x="436" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="536" y="420" /><di:waypoint x="613" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Data_Compare_di" bpmnElement="DOA_Data_Compare"><di:waypoint x="776" y="460" /><di:waypoint x="776" y="510" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
