<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx37_clause_review" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:process id="Proc_bx37_clause_review" name="조항 검토 (공유)" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {},
  "extensions": [],
  "outputs": [
    "결과"
  ],
  "inputs": [
    {
      "name": "조항",
      "type": "string",
      "required": true,
      "description": "원문"
    },
    {
      "name": "종류",
      "type": "string",
      "required": true,
      "description": "손해배상/지식재산/해지"
    },
    {
      "name": "표준조항",
      "type": "dict",
      "required": false,
      "description": "종류별 사내 표준",
      "default": {
        "손해배상": "직접 손해에 한하며 계약금액을 한도로 한다",
        "지식재산": "산출물의 권리는 발주자에게 귀속",
        "해지": "30일 전 서면 통지"
      }
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="시작">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_Empty" name="조항 있음?" default="Flow_03">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Review" name="조항 검토">
      <bpmn:extensionElements>
        <chk:aiTask>{
  "goal": "## 상황\n`조항`은 계약서의 `종류` 조항 원문이다. `표준조항[종류]`가 사내 표준이다.\n\n## 할 일\n표준과 비교해 위험 점수(0 없음 ~ 5 매우 높음), 이유, 수정 제안 문구를 낸다.\n\n## 판단하지 않는 것\n다른 종류의 조항을 평가하지 않는다.\n\n## 반환\n- `결과`: {점수(int), 이유(string), 제안(string)}",
  "domain": "llm",
  "results": {
    "결과": "dict"
  },
  "tools": [],
  "params": {}
}</chk:aiTask>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_Missing" name="조항 없음" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:script>결과 = dict(점수=3, 이유='조항이 없음', 제안=표준조항[종류])</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Gw_Empty" />
    <bpmn:sequenceFlow id="Flow_02" name="있음" sourceRef="Gw_Empty" targetRef="Task_Review">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">조항 != ''</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03" name="없음" sourceRef="Gw_Empty" targetRef="Task_Missing" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Review" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_Missing" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx37_clause_review">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Empty_di" bpmnElement="Gw_Empty" isMarkerVisible="true"><dc:Bounds x="266" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="246" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review"><dc:Bounds x="386" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Missing_di" bpmnElement="Task_Missing"><dc:Bounds x="386" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="556" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="536" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="291" y="145" /><di:waypoint x="291" y="270" /><di:waypoint x="386" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="295" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="316" y="120" /><di:waypoint x="386" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="320" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="486" y="270" /><di:waypoint x="531" y="270" /><di:waypoint x="531" y="120" /><di:waypoint x="556" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="486" y="120" /><di:waypoint x="556" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
