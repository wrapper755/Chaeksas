<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx21_leave_request" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:message id="Msg_leave_request" name="leave_request" />
  <bpmn:process id="Proc_bx21_leave_request" name="휴가 신청" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {
    "hris": "hr-hris"
  },
  "extensions": [
    {
      "id": "hris",
      "version": "&gt;=1,&lt;2"
    }
  ],
  "outputs": [],
  "inputs": [
    {
      "name": "신청번호",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "사번",
      "type": "string",
      "required": true,
      "description": ""
    },
    {
      "name": "시작일",
      "type": "date",
      "required": true,
      "description": ""
    },
    {
      "name": "일수",
      "type": "number",
      "required": true,
      "description": "반차 0.5"
    },
    {
      "name": "회신주소",
      "type": "string",
      "required": true,
      "description": "그룹웨어 회신 웹훅"
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="휴가 신청">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_leave_request" />
    </bpmn:startEvent>
    <bpmn:callActivity id="Call_Balance" name="잔여 휴가 (BX-24)" calledElement="Proc_bx24_leave_balance">
      <bpmn:extensionElements>
        <chk:call>{
  "input": {
    "사번": "사번"
  },
  "output": {
    "잔여": "잔여"
  }
}</chk:call>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gw_Enough" name="잔여 충분?" default="Flow_04">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Approve_Lead" name="팀장 결재">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "휴가 결재 (팀장)",
  "description": "",
  "show": [
    "사번",
    "시작일",
    "일수",
    "잔여"
  ],
  "fields": [
    {
      "key": "승인",
      "label": "승인",
      "type": "bool",
      "required": true
    },
    {
      "key": "의견",
      "label": "의견",
      "type": "text",
      "required": false
    }
  ],
  "location": "center"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Long" name="3일 초과?" default="Flow_07">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Approve_Head" name="부서장 결재">
      <bpmn:extensionElements>
        <chk:approval>{
  "title": "휴가 결재 (부서장)",
  "description": "",
  "show": [
    "사번",
    "시작일",
    "일수",
    "잔여",
    "의견"
  ],
  "fields": [
    {
      "key": "승인",
      "label": "승인",
      "type": "bool",
      "required": true
    }
  ],
  "location": "center"
}</chk:approval>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Result" name="승인?" default="Flow_10">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Register" name="근태 등록">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "hris",
  "operation": "register_leave",
  "input": {
    "emp_id": "사번",
    "start": "시작일",
    "days": "일수"
  },
  "output": {
    "등록": "result"
  }
}</chk:serviceCall>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_Approved" name="승인 정리" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:script>결과 = '승인'</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Reject" name="반려 정리" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:script>결과 = '반려'</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:sendTask id="Task_Reply" name="그룹웨어 회신">
      <bpmn:extensionElements>
        <chk:webhook>{
  "url": "{회신주소}",
  "method": "POST",
  "body": "fields:[신청번호, 결과]",
  "timeout_s": 10,
  "store_as": null
}</chk:webhook>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Call_Balance" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Call_Balance" targetRef="Gw_Enough" />
    <bpmn:sequenceFlow id="Flow_03" name="충분" sourceRef="Gw_Enough" targetRef="Approve_Lead">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">잔여 &gt;= 일수</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" name="부족" sourceRef="Gw_Enough" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Approve_Lead" targetRef="Gw_Long" />
    <bpmn:sequenceFlow id="Flow_06" name="초과" sourceRef="Gw_Long" targetRef="Approve_Head">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">승인 and 일수 &gt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07" name="이하·반려" sourceRef="Gw_Long" targetRef="Gw_Result" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Approve_Head" targetRef="Gw_Result" />
    <bpmn:sequenceFlow id="Flow_09" name="승인" sourceRef="Gw_Result" targetRef="Task_Register">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">승인</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" name="반려" sourceRef="Gw_Result" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Register" targetRef="Task_Approved" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Approved" targetRef="Task_Reply" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Reject" targetRef="Task_Reply" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Reply" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx21_leave_request">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Balance_di" bpmnElement="Call_Balance"><dc:Bounds x="266" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Enough_di" bpmnElement="Gw_Enough" isMarkerVisible="true"><dc:Bounds x="436" y="95" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="416" y="149" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Lead_di" bpmnElement="Approve_Lead"><dc:Bounds x="556" y="230" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Long_di" bpmnElement="Gw_Long" isMarkerVisible="true"><dc:Bounds x="726" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="706" y="299" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Approve_Head_di" bpmnElement="Approve_Head"><dc:Bounds x="846" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Result_di" bpmnElement="Gw_Result" isMarkerVisible="true"><dc:Bounds x="1016" y="245" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="996" y="299" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register"><dc:Bounds x="1136" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approved_di" bpmnElement="Task_Approved"><dc:Bounds x="1306" y="380" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject"><dc:Bounds x="1136" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reply_di" bpmnElement="Task_Reply"><dc:Bounds x="1476" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1646" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1626" y="142" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="120" /><di:waypoint x="266" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="120" /><di:waypoint x="436" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="461" y="145" /><di:waypoint x="461" y="270" /><di:waypoint x="556" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="465" y="252" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="486" y="120" /><di:waypoint x="1136" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="490" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="656" y="270" /><di:waypoint x="726" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="751" y="295" /><di:waypoint x="751" y="420" /><di:waypoint x="846" y="420" /><bpmndi:BPMNLabel><dc:Bounds x="755" y="402" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="776" y="270" /><di:waypoint x="1016" y="270" /><bpmndi:BPMNLabel><dc:Bounds x="780" y="252" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="946" y="420" /><di:waypoint x="991" y="420" /><di:waypoint x="991" y="270" /><di:waypoint x="1016" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1041" y="295" /><di:waypoint x="1041" y="420" /><di:waypoint x="1136" y="420" /><bpmndi:BPMNLabel><dc:Bounds x="1045" y="402" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1041" y="245" /><di:waypoint x="1041" y="120" /><di:waypoint x="1136" y="120" /><bpmndi:BPMNLabel><dc:Bounds x="1045" y="102" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1236" y="420" /><di:waypoint x="1306" y="420" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1406" y="420" /><di:waypoint x="1451" y="420" /><di:waypoint x="1451" y="120" /><di:waypoint x="1476" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1236" y="120" /><di:waypoint x="1476" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1576" y="120" /><di:waypoint x="1646" y="120" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
