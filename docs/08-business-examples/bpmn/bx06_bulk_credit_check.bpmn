<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_bx06_bulk_credit_check" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:process id="Proc_bx06_bulk_credit_check" name="다건 거래처 신용 조회" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "service_keys": {
    "ext-credit": "finance-credit"
  },
  "extensions": [
    {
      "id": "ext-credit",
      "version": "&gt;=1,&lt;2"
    }
  ],
  "outputs": [],
  "inputs": [
    {
      "name": "거래처목록",
      "type": "list",
      "required": true,
      "description": "{사업자번호, 이름}"
    },
    {
      "name": "영업팀메일",
      "type": "string",
      "required": false,
      "description": "",
      "default": "sales@example.com"
    },
    {
      "name": "재무팀메일",
      "type": "string",
      "required": false,
      "description": "",
      "default": "finance@example.com"
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="조회 요청">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Credit" name="신용 조회">
      <bpmn:extensionElements>
        <chk:serviceCall>{
  "app_id": "ext-credit",
  "operation": "lookup",
  "input": {
    "biz_no": "거래처.사업자번호"
  },
  "output": {
    "신용": "result"
  },
  "retry": {
    "max": 2,
    "on": [
      429,
      503
    ]
  }
}</chk:serviceCall>
        <chk:loop>{
  "collection": "거래처목록",
  "item": "거래처",
  "result": "신용",
  "collect_into": "신용목록"
}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" />
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Grade" name="등급 나누기">
      <bpmn:extensionElements>
        <chk:rule>{
  "decision": "credit_grade",
  "input": {
    "score": "신용.score",
    "overdue": "신용.overdue"
  },
  "output": {
    "등급": "grade"
  }
}</chk:rule>
        <chk:loop>{
  "collection": "신용목록",
  "item": "신용",
  "result": "등급",
  "collect_into": "등급목록"
}</chk:loop>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="Task_Pick" name="위험 거래처 추리기" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Data_Result">
        <bpmn:targetRef>Data_Result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>결과표 = [dict(거래처, 등급=g) for 거래처, g in zip(거래처목록, 등급목록)]
위험 = [x for x in 결과표 if x.등급 == '위험']
위험수 = len(위험)</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gw_Risk" name="위험 있음?" default="Flow_06">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Alert" name="위험 알림">
      <bpmn:extensionElements>
        <chk:email>{
  "to": [
    "{영업팀메일}",
    "{재무팀메일}"
  ],
  "subject": "신용 위험 거래처 {위험수}곳",
  "body": "첨부를 확인하세요.",
  "attachments": [
    "결과경로"
  ],
  "store_as": null
}</chk:email>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Credit" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Credit" targetRef="Task_Grade" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Grade" targetRef="Task_Pick" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Pick" targetRef="Gw_Risk" />
    <bpmn:sequenceFlow id="Flow_05" name="있음" sourceRef="Gw_Risk" targetRef="Task_Alert">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">위험수 &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" name="없음" sourceRef="Gw_Risk" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_Alert" targetRef="End" />
    <bpmn:dataObject id="DO_Data_Result" />
    <bpmn:dataObjectReference id="Data_Result" name="신용 조회 결과" dataObjectRef="DO_Data_Result">
      <bpmn:extensionElements>
        <chk:dataOutput>{
  "path": "신용/{오늘}_신용조회.xlsx",
  "format": "xlsx",
  "store_as": "결과경로",
  "variables": [
    "결과표"
  ],
  "sheet": "결과"
}</chk:dataOutput>
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_bx06_bulk_credit_check">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Credit_di" bpmnElement="Task_Credit"><dc:Bounds x="266" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Grade_di" bpmnElement="Task_Grade"><dc:Bounds x="436" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pick_di" bpmnElement="Task_Pick"><dc:Bounds x="606" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Risk_di" bpmnElement="Gw_Risk" isMarkerVisible="true"><dc:Bounds x="776" y="135" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="189" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Alert_di" bpmnElement="Task_Alert"><dc:Bounds x="896" y="270" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1066" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1046" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Result_di" bpmnElement="Data_Result"><dc:Bounds x="638" y="20" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="680" y="36" width="106" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="160" /><di:waypoint x="266" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="160" /><di:waypoint x="436" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="536" y="160" /><di:waypoint x="606" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="706" y="160" /><di:waypoint x="776" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="801" y="185" /><di:waypoint x="801" y="310" /><di:waypoint x="896" y="310" /><bpmndi:BPMNLabel><dc:Bounds x="805" y="292" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="826" y="160" /><di:waypoint x="1066" y="160" /><bpmndi:BPMNLabel><dc:Bounds x="830" y="142" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="996" y="310" /><di:waypoint x="1041" y="310" /><di:waypoint x="1041" y="160" /><di:waypoint x="1066" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Data_Result_di" bpmnElement="DOA_Data_Result"><di:waypoint x="656" y="120" /><di:waypoint x="656" y="70" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
