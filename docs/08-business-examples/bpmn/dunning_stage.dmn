<?xml version="1.0" encoding="UTF-8"?>
<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Defs_dunning_stage" name="연체 단계" namespace="urn:chaeksas:examples">
  <dmn:decision id="dunning_stage" name="연체 단계">
    <dmn:decisionTable id="DT_dunning_stage" hitPolicy="FIRST">
      <dmn:input id="In_0" label="연체일수">
        <dmn:inputExpression id="InE_0" typeRef="number"><dmn:text>연체일수</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:input id="In_1" label="금액">
        <dmn:inputExpression id="InE_1" typeRef="number"><dmn:text>금액</dmn:text></dmn:inputExpression>
      </dmn:input>
      <dmn:output id="Out_0" name="단계" typeRef="string" />
      <dmn:rule id="Rule_0">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R0_I0"><dmn:text>&gt;= 90</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R0_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R0_O0"><dmn:text>"이관검토"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_1">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R1_I0"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R1_I1"><dmn:text>&gt;= 100000000</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R1_O0"><dmn:text>"이관검토"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_2">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R2_I0"><dmn:text>[30..90)</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R2_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R2_O0"><dmn:text>"2차"</dmn:text></dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_3">
        <dmn:description></dmn:description>
        <dmn:inputEntry id="R3_I0"><dmn:text>[1..30)</dmn:text></dmn:inputEntry>
        <dmn:inputEntry id="R3_I1"><dmn:text>-</dmn:text></dmn:inputEntry>
        <dmn:outputEntry id="R3_O0"><dmn:text>"1차"</dmn:text></dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
