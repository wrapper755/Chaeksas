<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:chk="urn:chaeksas:bpmn:1"
  id="Defs_fx22_append_output" targetNamespace="urn:chaeksas:examples" exporter="chaeksas-examples" exporterVersion="1">
  <bpmn:process id="Proc_fx22_append_output" name="파일 출력 — csv 덧붙이기와 txt" isExecutable="true">
    <bpmn:extensionElements>
      <chk:process>{
  "run_location": "server",
  "extensions": [],
  "outputs": [],
  "inputs": [
    {
      "name": "건수",
      "type": "int",
      "required": true,
      "description": ""
    },
    {
      "name": "담당",
      "type": "string",
      "required": true,
      "description": ""
    }
  ]
}</chk:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="시작">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Row" name="오늘 한 줄" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Data_Csv">
        <bpmn:targetRef>Data_Csv</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>줄 = [{'날짜': str(오늘), '건수': 건수, '담당': 담당}]</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Text" name="글로도" scriptFormat="chk-expr">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Data_Txt">
        <bpmn:targetRef>Data_Txt</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script>본문 = f'{오늘} 처리 {건수}건 (담당 {담당})'</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Count" name="쓴 파일 세기">
      <bpmn:extensionElements>
        <chk:fileList>{
  "folder": "일지",
  "pattern": "*.*",
  "recursive": false,
  "sort": "name",
  "store_as": "일지파일",
  "count_as": "일지파일수"
}</chk:fileList>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Task_Row" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Row" targetRef="Task_Text" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Text" targetRef="Task_Count" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_Count" targetRef="End" />
    <bpmn:dataObject id="DO_Data_Csv" />
    <bpmn:dataObjectReference id="Data_Csv" name="일지(csv)" dataObjectRef="DO_Data_Csv">
      <bpmn:extensionElements>
        <chk:dataOutput>{
  "path": "일지/처리일지.csv",
  "format": "csv",
  "store_as": "일지경로",
  "variables": [
    "줄"
  ],
  "append": true
}</chk:dataOutput>
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
    <bpmn:dataObject id="DO_Data_Txt" />
    <bpmn:dataObjectReference id="Data_Txt" name="일지(txt)" dataObjectRef="DO_Data_Txt">
      <bpmn:extensionElements>
        <chk:dataOutput>{
  "path": "일지/처리일지.txt",
  "format": "txt",
  "store_as": "글경로",
  "template": "{본문}\n",
  "append": true
}</chk:dataOutput>
      </bpmn:extensionElements>
    </bpmn:dataObjectReference>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_fx22_append_output">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Row_di" bpmnElement="Task_Row"><dc:Bounds x="266" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Text_di" bpmnElement="Task_Text"><dc:Bounds x="436" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Count_di" bpmnElement="Task_Count"><dc:Bounds x="606" y="120" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="776" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="756" y="182" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Csv_di" bpmnElement="Data_Csv"><dc:Bounds x="298" y="20" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="340" y="36" width="94" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Txt_di" bpmnElement="Data_Txt"><dc:Bounds x="468" y="20" width="36" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="510" y="36" width="94" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="160" /><di:waypoint x="266" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="366" y="160" /><di:waypoint x="436" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="536" y="160" /><di:waypoint x="606" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="706" y="160" /><di:waypoint x="776" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Data_Csv_di" bpmnElement="DOA_Data_Csv"><di:waypoint x="316" y="120" /><di:waypoint x="316" y="70" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_Data_Txt_di" bpmnElement="DOA_Data_Txt"><di:waypoint x="486" y="120" /><di:waypoint x="486" y="70" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
